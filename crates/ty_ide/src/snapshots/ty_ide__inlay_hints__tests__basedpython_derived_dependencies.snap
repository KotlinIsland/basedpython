from basedpython_ui import State, composable, derived, remember, state, state_list

def validate(value: str) -> str?:
    return None if value else "required"

def total_of(cell: State[int]) -> int:
    return cell.value

@composable
def Form():
    let name = state("")
    let email = state("")
    let count = state(0)
    let items = state_list([1])
    let name_error = derived(lambda: validate(name.value))[ depends on name]
    let full = derived(lambda: name.value + email.value)[ depends on name, email]
    let total = derived(lambda: total_of(count) + sum(1 for item in items if item))[ depends on count, items]
    let cached = remember(lambda: count.value * 2)[ depends on count]
    let constant = derived(lambda: 1)

