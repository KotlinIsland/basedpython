from basedpython_ui import State, StateList, composable

frozen data class Todo:
    title: str

data class Draft:
    title: str

@composable
def TodoList(
    [unstable ]items: list[str],
    view: list[out str],
    todos: StateList[Todo],
    [unstable ]draft: Draft,
    todo: Todo,
    count: State[int],
    on_click: () -> None,
    untyped,
    [unstable ]table: dict[str, int] = {},
): ...

def helper(items: list[str]): ...
