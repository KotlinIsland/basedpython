        def subgroup(
            self, matcher_value: (ExceptionT | Self) -> bool, /
        ) -> ExceptionGroup[ExceptionT] | None

        def split[ExceptionT2: Exception](
            self, matcher_value: type[ExceptionT2] | (*: type[ExceptionT2]), /
        ) -> (ExceptionGroup[ExceptionT2] | None, ExceptionGroup[ExceptionT] | None)
        def split(
