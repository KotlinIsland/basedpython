            cls,
            func: (T1, T2, T3) -> Other,
            iterable: Iterable[T1],
            iter2: Iterable[T2],
            iter3: Iterable[T3],
            /,
            *,
            strict: bool = False,
        ) -> Self
        def __new__[T1, T2, T3, T4](
            cls,
            func: (T1, T2, T3, T4) -> Other,
            iterable: Iterable[T1],
            iter2: Iterable[T2],
            iter3: Iterable[T3],
            iter4: Iterable[T4],
            /,
            *,
            strict: bool = False,
        ) -> Self
        def __new__[T1, T2, T3, T4, T5](
            cls,
            func: (T1, T2, T3, T4, T5) -> Other,
            iterable: Iterable[T1],
            iter2: Iterable[T2],
            iter3: Iterable[T3],
            iter4: Iterable[T4],
            iter5: Iterable[T5],
            /,
            *,
            strict: bool = False,
        ) -> Self
        def __new__(
            cls,
            func: (...) -> Other,
            iterable: Iterable[dynamic],
            iter2: Iterable[dynamic],
            iter3: Iterable[dynamic],
            iter4: Iterable[dynamic],
            iter5: Iterable[dynamic],
            iter6: Iterable[dynamic],
            /,
            *iterables: Iterable[dynamic],
            strict: bool = False,
        ) -> Self
    else:
        def __new__[T1](cls, func: (T1) -> Other, iterable: Iterable[T1], /) -> Self
        def __new__[T1, T2](cls, func: (T1, T2) -> Other, iterable: Iterable[T1], iter2: Iterable[T2], /) -> Self
        def __new__[T1, T2, T3](
            cls, func: (T1, T2, T3) -> Other, iterable: Iterable[T1], iter2: Iterable[T2], iter3: Iterable[T3], /
        ) -> Self
        def __new__[T1, T2, T3, T4](
            cls,
            func: (T1, T2, T3, T4) -> Other,
            iterable: Iterable[T1],
            iter2: Iterable[T2],
            iter3: Iterable[T3],
            iter4: Iterable[T4],
            /,
        ) -> Self
        def __new__[T1, T2, T3, T4, T5](
            cls,
            func: (T1, T2, T3, T4, T5) -> Other,
            iterable: Iterable[T1],
            iter2: Iterable[T2],
            iter3: Iterable[T3],
            iter4: Iterable[T4],
            iter5: Iterable[T5],
            /,
        ) -> Self
        def __new__(
            cls,
            func: (...) -> Other,
            iterable: Iterable[dynamic],
            iter2: Iterable[dynamic],
            iter3: Iterable[dynamic],
            iter4: Iterable[dynamic],
            iter5: Iterable[dynamic],
            iter6: Iterable[dynamic],
            /,
            *iterables: Iterable[dynamic],
        ) -> Self

