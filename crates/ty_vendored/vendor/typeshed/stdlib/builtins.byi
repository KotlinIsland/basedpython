@type_check_only
protocol _SupportsPow3[in E, in M, out Element]:
    def __pow__(self, other: E, modulo: M, /) -> Element

type _SupportsSomeKindOfPow = (
    _SupportsPow2[dynamic, dynamic] | _SupportsPow3NoneOnly[dynamic, dynamic] | _SupportsPow3[dynamic, dynamic, dynamic]
