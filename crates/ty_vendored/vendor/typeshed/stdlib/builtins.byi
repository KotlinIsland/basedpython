            self, matcher_value: type[ExceptionT] | (*: type[ExceptionT]), /
        ) -> ExceptionGroup[ExceptionT] | None
        def subgroup[BaseExceptionT2: BaseException](
            self, matcher_value: type[BaseExceptionT2] | (*: type[BaseExceptionT2]), /
        ) -> BaseExceptionGroup[BaseExceptionT2] | None
        def subgroup(
            self, matcher_value: (BaseExceptionT | Self) -> bool, /
        ) -> BaseExceptionGroup[BaseExceptionT] | None

        def split[ExceptionT: Exception](
            self, matcher_value: type[ExceptionT] | (*: type[ExceptionT]), /
        ) -> (ExceptionGroup[ExceptionT] | None, BaseExceptionGroup[BaseExceptionT] | None)
        def split[BaseExceptionT2: BaseException](
            self, matcher_value: type[BaseExceptionT2] | (*: type[BaseExceptionT2]), /
        ) -> (BaseExceptionGroup[BaseExceptionT2] | None, BaseExceptionGroup[BaseExceptionT] | None)
        def split(
            self, matcher_value: (BaseExceptionT | Self) -> bool, /
        ) -> (BaseExceptionGroup[BaseExceptionT] | None, BaseExceptionGroup[BaseExceptionT] | None)

        # In reality it is `NonEmptySequence`:
        def derive[ExceptionT: Exception](self, excs: Sequence[ExceptionT], /) -> ExceptionGroup[ExceptionT]
        def derive[BaseExceptionT2: BaseException](self, excs: Sequence[BaseExceptionT2], /) -> BaseExceptionGroup[BaseExceptionT2]

