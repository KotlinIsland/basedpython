def pow(base: int, exp: _NegativeInteger, mod: None = None) -> float

# int base & positive-int exp -> int; int base & negative-int exp -> float
# return type must be Any as `int | float` causes too many false-positive errors
def pow(base: int, exp: int, mod: None = None) -> dynamic
def pow(base: _PositiveInteger, exp: float, mod: None = None) -> float
def pow(base: _NegativeInteger, exp: float, mod: None = None) -> complex
def pow(base: float, exp: int, mod: None = None) -> float

# float base & float exp could return float or complex
# return type must be Any (same as complex base, complex exp),
# as `float | complex` causes too many false-positive errors
def pow(base: float, exp: complex | _SupportsSomeKindOfPow, mod: None = None) -> dynamic
def pow(base: complex, exp: complex | _SupportsSomeKindOfPow, mod: None = None) -> complex
def pow[E, Element](base: _SupportsPow2[E, Element], exp: E, mod: None = None) -> Element
def pow[E, Element](base: _SupportsPow3NoneOnly[E, Element], exp: E, mod: None = None) -> Element
def pow[E, M, Element](base: _SupportsPow3[E, M, Element], exp: E, mod: M) -> Element
def pow(base: _SupportsSomeKindOfPow, exp: float, mod: None = None) -> dynamic
def pow(base: _SupportsSomeKindOfPow, exp: complex, mod: None = None) -> complex

