        """Import produces a cycle."""

class LookupError(Exception):
    """Base class for lookup errors."""

class MemoryError(Exception):
    """Out of memory."""

@disjoint_base
class NameError(Exception):
    """Name not found globally."""

    init(self, *args: object, name: str | None = None)
    name: str | None
    """name"""

class ReferenceError(Exception):
    """Weak ref proxy used after referent went away."""

class RuntimeError(Exception):
    """Unspecified run-time error."""

class StopAsyncIteration(Exception):
    """Signal the end from iterator.__anext__()."""

@disjoint_base
class SyntaxError(Exception):
    """Invalid syntax."""

    msg: str
    """exception msg"""

    filename: str | None
    """exception filename"""

    lineno: int | None
    """exception lineno"""

    offset: int | None
    """exception offset"""

    text: str | None
    """exception text"""

    # Errors are displayed differently if this attribute exists on the exception.
    # The value is always None.
    print_file_and_line: None
    """exception print_file_and_line"""

    end_lineno: int | None
    """exception end lineno"""

    end_offset: int | None
    """exception end offset"""

    init(self)
    init(self, msg: object, /)
    # Second argument is the tuple (filename, lineno, offset, text)
    init(self, msg: str, info: (str | None, int | None, int | None, str | None), /)
    # end_lineno and end_offset must both be provided if one is.
    init(
        self, msg: str, info: (str | None, int | None, int | None, str | None, int | None, int | None), /
    )
    # If you provide more than two arguments, it still creates the SyntaxError, but
    # the arguments from the info tuple are not parsed. This form is omitted.

class SystemError(Exception):
    """Internal error in the Python interpreter.

    Please report this to the Python maintainer, along with the traceback,
    the Python version, and the hardware/OS platform and version.
    """

