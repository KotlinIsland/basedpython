"""Implements InterpreterPoolExecutor."""

import sys
from collections.abc import Callable
from concurrent.futures import ThreadPoolExecutor
from typing import Literal, ParamSpec, Protocol, TypeAlias, type_check_only
from typing_extensions import Self, TypeVar, TypeVarTuple, Unpack

private type Task = (bytes, "function" | "script")

@type_check_only
private protocol TaskFunc:
    def __call__[Parameters: (*: *, **: *), R](self, fn: (**Parameters) -> R, *args: *Parameters, **kwargs: **Parameters) -> (bytes, "function")
    def __call__(self, fn: str) -> (bytes, "script")

if sys.version_info >= (3, 14):
    from concurrent.futures.thread import BrokenThreadPool, WorkerContext as ThreadWorkerContext
    from concurrent.interpreters import Interpreter, Queue

    def do_call[R](results: Queue, func: (...) -> R, args: (*: dynamic), kwargs: dict[str, dynamic]) -> R

    class WorkerContext(ThreadWorkerContext):
        interp: Interpreter | None
        results: Queue | None

        class def prepare[*Args](
            cls, initializer: (*Args) -> object, initargs: (Unpack[Args],)
        ) -> (() -> Self, TaskFunc)
        class def prepare(cls, initializer: () -> object, initargs: tuple[()]) -> (() -> Self, TaskFunc)

        init(self, initdata: Task)
        def __del__(self)
        def run(self, task: Task)

    class BrokenInterpreterPool(BrokenThreadPool):
        """
        Raised when a worker thread in an InterpreterPoolExecutor failed initializing.
        """

    class InterpreterPoolExecutor(ThreadPoolExecutor):
        BROKEN: type[BrokenInterpreterPool]

        class def prepare_context(
            cls, initializer: () -> object, initargs: tuple[()]
        ) -> (() -> WorkerContext, TaskFunc)
        class def prepare_context[*Args](
            cls, initializer: (*Args) -> object, initargs: (Unpack[Args],)
        ) -> (() -> WorkerContext, TaskFunc)

        init(
            self,
            max_workers: int | None = None,
            thread_name_prefix: str = "",
            initializer: (() -> object) | None = None,
            initargs: tuple[()] = (),
        ):
            """Initializes a new InterpreterPoolExecutor instance.

            Args:
                max_workers: The maximum number of interpreters that can be used
                    to execute the given calls.
                thread_name_prefix: An optional name prefix to give our threads.
                initializer: A callable or script used to initialize
                    each worker interpreter.
                initargs: A tuple of arguments to pass to the initializer.
            """
        def __init__[*Args](
            self,
            max_workers: int | None = None,
            thread_name_prefix: str = "",
            *,
            initializer: (*Args) -> object,
            initargs: (Unpack[Args],),
        ) -> None
        def __init__[*Args](
            self,
            max_workers: int | None,
            thread_name_prefix: str,
            initializer: (*Args) -> object,
            initargs: (Unpack[Args],),
        ) -> None
