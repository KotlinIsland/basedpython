"""Utilities for with-statement contexts.  See PEP 343."""

import abc
import sys
from _typeshed import FileDescriptorOrPath, Unused
from abc import ABC
from collections.abc import AsyncGenerator, AsyncIterator, Awaitable, Callable, Generator, Iterator
from types import TracebackType
from typing import Generic, ParamSpec, Protocol, TypeAlias, TypeVar, runtime_checkable, type_check_only
from typing_extensions import Self, deprecated

__all__ = [
    "aclosing",
    "contextmanager",
    "closing",
    "AbstractContextManager",
    "ContextDecorator",
    "ExitStack",
    "redirect_stdout",
    "redirect_stderr",
    "suppress",
    "AbstractAsyncContextManager",
    "AsyncExitStack",
    "asynccontextmanager",
    "nullcontext",
]

if sys.version_info >= (3, 11):
    __all__ += ["chdir"]



private type ExitFunc = (type[BaseException]?, BaseException?, TracebackType?) -> (bool?)

# mypy and pyright object to this being both ABC and Protocol.
# At runtime it inherits from ABC and is not a Protocol, but it is on the
# allowlist for use as a Protocol.
@runtime_checkable
protocol AbstractContextManager[out Element, out ExitT: bool? = bool?](ABC):
    """An abstract base class for context managers."""

    __slots__ = ()
    abstract def __enter__(self) -> Element:
        """Return `self` upon entering the runtime context."""

    abstract def __exit__(
        self, exc_type: type[BaseException]?, exc_value: BaseException?, traceback: TracebackType?, /
    ) -> ExitT:
        """Raise any exception triggered within the runtime context."""

# mypy and pyright object to this being both ABC and Protocol.
# At runtime it inherits from ABC and is not a Protocol, but it is on the
# allowlist for use as a Protocol.
@runtime_checkable
protocol AbstractAsyncContextManager[out Element, out ExitT: bool? = bool?](ABC):
    """An abstract base class for asynchronous context managers."""

    __slots__ = ()
    abstract async def __aenter__(self) -> Element:
        """Return `self` upon entering the runtime context."""

    abstract async def __aexit__(
        self, exc_type: type[BaseException]?, exc_value: BaseException?, traceback: TracebackType?, /
    ) -> ExitT:
        """Raise any exception triggered within the runtime context."""

class ContextDecorator:
    """A base class or mixin that enables context managers to work as decorators."""

    def _recreate_cm(self) -> Self:
        """Return a recreated instance of self.

        Allows an otherwise one-shot context manager like
        _GeneratorContextManager to support use as
        a decorator via implicit recreation.

        This is a private interface just for _GeneratorContextManager.
        See issue #11647 for details.
        """

    def __call__[F: (...) -> dynamic](self, func: F) -> F

class _GeneratorContextManagerBase[out G: Generator[dynamic, dynamic, dynamic] | AsyncGenerator[dynamic, dynamic]]:
    """Shared functionality for @contextmanager and @asynccontextmanager."""

    # Ideally this would use ParamSpec, but that requires (*args, **kwargs), which this isn't. see #6676
    init(self, func: (...) -> G, args: (*: dynamic), kwds: dict[str, dynamic])
    gen: G
    func: (...) -> G
    args: (*: dynamic)
    kwds: dict[str, dynamic]

class _GeneratorContextManager[out Element, in Send = None, out Return = None](_GeneratorContextManagerBase[Generator[Element, Send, Return]], AbstractContextManager[Element, bool | None], ContextDecorator):
    """Helper for @contextmanager decorator."""

    override def __enter__(self) -> Element
    override def __exit__(
        self, typ: type[BaseException]?, value: BaseException?, traceback: TracebackType?
    ) -> bool?

def contextmanager[Parameters: (*: *, **: *), Element](func: (**Parameters) -> Generator[Element, None, object]) -> (**Parameters) -> _GeneratorContextManager[Element]:
    """@contextmanager decorator.

    Typical usage:

        @contextmanager
        def some_generator(<arguments>):
            <setup>
            try:
                yield <value>
            finally:
                <cleanup>

    This makes this:

        with some_generator(<arguments>) as <variable>:
            <body>

    equivalent to this:

        <setup>
        try:
            <variable> = <value>
            <body>
        finally:
            <cleanup>
    """
@deprecated(
    "Annotating the return type as `-> Iterator[Foo]` with `@contextmanager` is deprecated. Use `-> Generator[Foo]` instead."
)
def contextmanager[Parameters: (*: *, **: *), Element](func: (**Parameters) -> Iterator[Element]) -> (**Parameters) -> _GeneratorContextManager[Element]


class AsyncContextDecorator:
    """A base class or mixin that enables async context managers to work as decorators."""

    def _recreate_cm(self) -> Self:
        """Return a recreated instance of self."""

    def __call__[AF: (...) -> Awaitable[dynamic]](self, func: AF) -> AF

class _AsyncGeneratorContextManager[out Element, in Send = None](_GeneratorContextManagerBase[AsyncGenerator[Element, Send]], AbstractAsyncContextManager[Element, bool | None], AsyncContextDecorator):
    """Helper for @asynccontextmanager decorator."""

    override async def __aenter__(self) -> Element
    override async def __aexit__(
        self, typ: type[BaseException]?, value: BaseException?, traceback: TracebackType?
    ) -> bool?

def asynccontextmanager[Parameters: (*: *, **: *), Element](func: (**Parameters) -> AsyncGenerator[Element]) -> (**Parameters) -> _AsyncGeneratorContextManager[Element]:
    """@asynccontextmanager decorator.

    Typical usage:

        @asynccontextmanager
        async def some_async_generator(<arguments>):
            <setup>
            try:
                yield <value>
            finally:
                <cleanup>

    This makes this:

        async with some_async_generator(<arguments>) as <variable>:
            <body>

    equivalent to this:

        <setup>
        try:
            <variable> = <value>
            <body>
        finally:
            <cleanup>
    """
@deprecated(
    "Annotating the return type as `-> AsyncIterator[Foo]` with `@asynccontextmanager` is deprecated. "
    "Use `-> AsyncGenerator[Foo]` instead."
)
def asynccontextmanager[Parameters: (*: *, **: *), Element](func: (**Parameters) -> AsyncIterator[Element]) -> (**Parameters) -> _AsyncGeneratorContextManager[Element]

@type_check_only
private protocol SupportsClose:
    def close(self) -> object


class closing[in out SupportsCloseT: SupportsClose](AbstractContextManager[SupportsCloseT, None]):
    """Context to automatically close something at the end of a block.

    Code like this:

        with closing(<module>.open(<arguments>)) as f:
            <block>

    is equivalent to this:

        f = <module>.open(<arguments>)
        try:
            <block>
        finally:
            f.close()

    """

    init(self, thing: SupportsCloseT)
    override def __enter__(self) -> SupportsCloseT
    override def __exit__(self, *exc_info: Unused)

@type_check_only
private protocol SupportsAclose:
    def aclose(self) -> Awaitable[object]


class aclosing[in out SupportsAcloseT: SupportsAclose](AbstractAsyncContextManager[SupportsAcloseT, None]):
    """Async context manager for safely finalizing an asynchronously cleaned-up
    resource such as an async generator, calling its ``aclose()`` method.

    Code like this:

        async with aclosing(<module>.fetch(<arguments>)) as agen:
            <block>

    is equivalent to this:

        agen = <module>.fetch(<arguments>)
        try:
            <block>
        finally:
            await agen.aclose()

    """

    init(self, thing: SupportsAcloseT)
    override async def __aenter__(self) -> SupportsAcloseT
    override async def __aexit__(self, *exc_info: Unused) -> None

class suppress(AbstractContextManager[None, bool]):
    """Context manager to suppress specified exceptions

    After the exception is suppressed, execution proceeds with the next
    statement following the with statement.

         with suppress(FileNotFoundError):
             os.remove(somefile)
         # Execution still resumes here if the file was already removed
    """

    init(self, *exceptions: type[BaseException])
    override def __enter__(self)
    override def __exit__(
        self, exctype: type[BaseException]?, excinst: BaseException?, exctb: TracebackType?
    ) -> bool

# This is trying to describe what is needed for (most?) uses
# of `redirect_stdout` and `redirect_stderr`.
# https://github.com/python/typeshed/issues/14903
@type_check_only
private protocol SupportsRedirect:
    def write(self, s: str, /) -> int
    def flush(self)


class _RedirectStream[in out SupportsRedirectT: SupportsRedirect?](AbstractContextManager[SupportsRedirectT, None]):
    init(self, new_target: SupportsRedirectT)
    override def __enter__(self) -> SupportsRedirectT
    override def __exit__(
        self, exctype: type[BaseException]?, excinst: BaseException?, exctb: TracebackType?
    )

class redirect_stdout[in out SupportsRedirectT: SupportsRedirect?](_RedirectStream[SupportsRedirectT]):
    """Context manager for temporarily redirecting stdout to another file.

    # How to send help() to stderr
    with redirect_stdout(sys.stderr):
        help(dir)

    # How to write help() to a file
    with open('help.txt', 'w') as f:
        with redirect_stdout(f):
            help(pow)
    """

class redirect_stderr[in out SupportsRedirectT: SupportsRedirect?](_RedirectStream[SupportsRedirectT]):
    """Context manager for temporarily redirecting stderr to another file."""

class _BaseExitStack[out ExitT: bool? = bool?]:
    """A base class for ExitStack and AsyncExitStack."""

    def enter_context[Element](self, cm: AbstractContextManager[Element, ExitT]) -> Element:
        """Enters the supplied context manager.

        If successful, also pushes its __exit__ method as a callback and
        returns the result of the __enter__ method.
        """

    def push[CM_EF: AbstractContextManager[dynamic, dynamic] | ExitFunc](self, exit: CM_EF) -> CM_EF:
        """Registers a callback with the standard __exit__ method signature.

        Can suppress exceptions the same way __exit__ method can.
        Also accepts any object with an __exit__ method (registering a call
        to the method instead of the object itself).
        """

    def callback[Parameters: (*: *, **: *), Element](self, callback: (**Parameters) -> Element, /, *args: *Parameters, **kwds: **Parameters) -> (**Parameters) -> Element:
        """Registers an arbitrary callback and arguments.

        Cannot suppress exceptions.
        """

    def pop_all(self) -> Self:
        """Preserve the context stack by transferring it to a new instance."""

# this class is to avoid putting `metaclass=abc.ABCMeta` on the implementations directly, as this would make them
# appear explicitly abstract to some tools. this is due to the implementations not subclassing `AbstractContextManager`
#  see note on the subclasses
@type_check_only
class _BaseExitStackAbstract[out ExitT: bool? = bool?](_BaseExitStack[ExitT], metaclass=abc.ABCMeta)

# In reality this is a subclass of `AbstractContextManager`, but we can't provide `Self` as the argument for `__enter__`
#  https://discuss.python.org/t/self-as-typevar-default/90939
class ExitStack[out ExitT: bool? = bool?](_BaseExitStackAbstract[ExitT]):
    """Context manager for dynamic management of a stack of exit callbacks.

    For example:
        with ExitStack() as stack:
            files = [stack.enter_context(open(fname)) for fname in filenames]
            # All opened files will automatically be closed at the end of
            # the with statement, even if attempts to open files later
            # in the list raise an exception.
    """

    def close(self):
        """Immediately unwind the context stack."""

    def __enter__(self) -> Self
    def __exit__(
        self, exc_type: type[BaseException]?, exc_value: BaseException?, traceback: TracebackType?, /
    ) -> ExitT

private type ExitCoroFunc = (type[BaseException]?, BaseException?, TracebackType?) -> Awaitable[bool?]

# In reality this is a subclass of `AbstractContextManager`, but we can't provide `Self` as the argument for `__enter__`
#  https://discuss.python.org/t/self-as-typevar-default/90939
class AsyncExitStack[out ExitT: bool? = bool?](_BaseExitStackAbstract[ExitT]):
    """Async context manager for dynamic management of a stack of exit
    callbacks.

    For example:
        async with AsyncExitStack() as stack:
            connections = [await stack.enter_async_context(get_connection())
                for i in range(5)]
            # All opened connections will automatically be released at the
            # end of the async with statement, even if attempts to open a
            # connection later in the list raise an exception.
    """

    async def enter_async_context[Element](self, cm: AbstractAsyncContextManager[Element, ExitT]) -> Element:
        """Enters the supplied async context manager.

        If successful, also pushes its __aexit__ method as a callback and
        returns the result of the __aenter__ method.
        """

    def push_async_exit[ACM_EF: AbstractAsyncContextManager[dynamic, dynamic] | ExitCoroFunc](self, exit: ACM_EF) -> ACM_EF:
        """Registers a coroutine function with the standard __aexit__ method
        signature.

        Can suppress exceptions the same way __aexit__ method can.
        Also accepts any object with an __aexit__ method (registering a call
        to the method instead of the object itself).
        """

    def push_async_callback[Parameters: (*: *, **: *), Element](
        self, callback: (**Parameters) -> Awaitable[Element], /, *args: *Parameters, **kwds: **Parameters
    ) -> (**Parameters) -> Awaitable[Element]:
        """Registers an arbitrary coroutine function and arguments.

        Cannot suppress exceptions.
        """

    async def aclose(self) -> None:
        """Immediately unwind the context stack."""

    async def __aenter__(self) -> Self
    async def __aexit__(
        self, exc_type: type[BaseException]?, exc_value: BaseException?, traceback: TracebackType?, /
    ) -> ExitT

class nullcontext[in out Element](AbstractContextManager[Element, None], AbstractAsyncContextManager[Element, None]):
    """Context manager that does no additional processing.

    Used as a stand-in for a normal context manager, when a particular
    block of code is only sometimes used with a normal context manager:

    cm = optional_cm if condition else nullcontext()
    with cm:
        # Perform operation, using optional_cm if condition is True
    """

    enter_result: Element

    init(self: nullcontext[None])
    init(self: nullcontext[Element], enter_result: Element)

    override def __enter__(self) -> Element
    override def __exit__(self, *exctype: Unused)
    override async def __aenter__(self) -> Element
    override async def __aexit__(self, *exctype: Unused) -> None

if sys.version_info >= (3, 11):

    class chdir[in out T_fd_or_any_path: FileDescriptorOrPath](AbstractContextManager[None, None]):
        """Non thread-safe context manager to change the current working directory."""

        path: T_fd_or_any_path
        init(self, path: T_fd_or_any_path)
        def __enter__(self)
        def __exit__(self, *excinfo: Unused)
