import _tkinter
import itertools
import tkinter
from typing import ClassVar, Final, Literal, TypeAlias, TypedDict, type_check_only
from typing_extensions import Unpack

__all__ = ["NORMAL", "ROMAN", "BOLD", "ITALIC", "nametofont", "Font", "families", "names"]

NORMAL: Final = "normal"
ROMAN: Final = "roman"
BOLD: Final = "bold"
ITALIC: Final = "italic"

type _FontDescription = (
    str  # "Helvetica 12"
    | Font  # A font object constructed in Python
    | list[dynamic]  # ["Helvetica", 12, BOLD]
    | tuple[str]  # ("Liberation Sans",) needs wrapping in tuple/list to handle spaces
    # ("Liberation Sans", 12) or ("Liberation Sans", 12, "bold", "italic", "underline")
    | tuple[str, int, Unpack[(*: str)]]  # Any number of trailing options is permitted
    | tuple[str, int, list[str] | (*: str)]  # Options can also be passed as list/tuple
    | _tkinter.Tcl_Obj  # A font object constructed in Tcl
)

@type_check_only
class _FontDict(TypedDict):
    family: str
    size: int
    weight: "normal" | "bold"
    slant: "roman" | "italic"
    underline: bool
    overstrike: bool

@type_check_only
class _MetricsDict(TypedDict):
    ascent: int
    descent: int
    linespace: int
    fixed: bool

class Font:
    """Represents a named font.

    Constructor options are:

    font -- font specifier (name, system font, or (family, size, style)-tuple)
    name -- name to use for this font configuration (defaults to a unique name)
    exists -- does a named font by this name already exist?
       Creates a new named font if False, points to the existing font if True.
       Raises _tkinter.TclError if the assertion is false.

       the following are ignored if font is specified:

    family -- font 'family', e.g. Courier, Times, Helvetica
    size -- font size in points
    weight -- font thickness: NORMAL, BOLD
    slant -- font slant: ROMAN, ITALIC
    underline -- font underlining: false (0), true (1)
    overstrike -- font strikeout: false (0), true (1)

    """

    name: str
    delete_font: bool
    counter: ClassVar[itertools.count[int]]  # undocumented
    init(
        self,
        # In tkinter, 'root' refers to tkinter.Tk by convention, but the code
        # actually works with any tkinter widget so we use tkinter.Misc.
        root: tkinter.Misc | None = None,
        font: _FontDescription | None = None,
        name: str | None = None,
        exists: bool = False,
        *,
        family: str = ...,
        size: int = ...,
        weight: "normal" | "bold" = ...,
        slant: "roman" | "italic" = ...,
        underline: bool = ...,
        overstrike: bool = ...,
    )
    __hash__: ClassVar[None]
    def __setitem__(self, key: str, value: dynamic) -> None

    def cget(self, option: "family") -> str:
        """Get font attribute"""
    def cget(self, option: "size") -> int
    def cget(self, option: "weight") -> "normal" | "bold"
    def cget(self, option: "slant") -> "roman" | "italic"
    def cget(self, option: "underline" | "overstrike") -> bool
    def cget(self, option: str) -> dynamic

    __getitem__ = cget

    def actual(self, option: "family", displayof: tkinter.Misc | None = None) -> str:
        """Return actual font attributes"""
    def actual(self, option: "size", displayof: tkinter.Misc | None = None) -> int
    def actual(self, option: "weight", displayof: tkinter.Misc | None = None) -> "normal" | "bold"
    def actual(self, option: "slant", displayof: tkinter.Misc | None = None) -> "roman" | "italic"
    def actual(self, option: "underline" | "overstrike", displayof: tkinter.Misc | None = None) -> bool
    def actual(self, option: None, displayof: tkinter.Misc | None = None) -> _FontDict
    def actual(self, *, displayof: tkinter.Misc | None = None) -> _FontDict

    def config(
        self,
        *,
        family: str = ...,
        size: int = ...,
        weight: "normal" | "bold" = ...,
        slant: "roman" | "italic" = ...,
        underline: bool = ...,
        overstrike: bool = ...,
    ) -> _FontDict | None:
        """Modify font attributes"""

    configure = config
    def copy(self) -> Font:
        """Return a distinct copy of the current font"""

    def metrics(self, option: "ascent" | "descent" | "linespace", /, *, displayof: tkinter.Misc | None = ...) -> int:
        """Return font metrics.

        For best performance, create a dummy widget
        using this font before calling this method.
        """
    def metrics(self, option: "fixed", /, *, displayof: tkinter.Misc | None = ...) -> bool
    def metrics(self, *, displayof: tkinter.Misc | None = ...) -> _MetricsDict

    def measure(self, text: str, displayof: tkinter.Misc | None = None) -> int:
        """Return text width"""

    override def __eq__(self, other: object) -> bool
    def __del__(self) -> None

def families(root: tkinter.Misc | None = None, displayof: tkinter.Misc | None = None) -> (*: str):
    """Get font families (as a tuple)"""

def names(root: tkinter.Misc | None = None) -> (*: str):
    """Get names of defined fonts (as a tuple)"""

def nametofont(name: str, root: tkinter.Misc | None = None) -> Font:
    """Given the name of a tk named font, returns a Font representation."""
