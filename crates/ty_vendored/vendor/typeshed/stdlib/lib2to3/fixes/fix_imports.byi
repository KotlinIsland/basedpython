"""Fix incompatible imports and module references."""

from _typeshed import StrPath
from collections.abc import Generator
from typing import ClassVar, Final, Literal

from .. import fixer_base
from ..pytree import Node

final MAPPING: dict[str, str]

def alternates(members)
def build_pattern(mapping=...) -> Generator[str]

class FixImports(fixer_base.BaseFix):
    BM_compatible: ClassVar[True]
    mapping = MAPPING
    def build_pattern(self)
    override def compile_pattern(self) -> None
    override def match(self, node)
    replace: dict[str, str]
    override def start_tree(self, tree: Node, filename: StrPath) -> None
    override def transform(self, node, results) -> None
