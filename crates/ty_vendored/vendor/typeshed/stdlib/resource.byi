import sys
from _typeshed import structseq
from typing import Final, final

if sys.platform != "win32":
    # Depends on resource.h
    final RLIMIT_AS: int
    final RLIMIT_CORE: int
    final RLIMIT_CPU: int
    final RLIMIT_DATA: int
    final RLIMIT_FSIZE: int
    final RLIMIT_MEMLOCK: int
    final RLIMIT_NOFILE: int
    final RLIMIT_NPROC: int
    final RLIMIT_RSS: int
    final RLIMIT_STACK: int
    final RLIM_INFINITY: int
    if sys.version_info >= (3, 15):
        final RLIM_SAVED_CUR: int
        final RLIM_SAVED_MAX: int
    final RUSAGE_CHILDREN: int
    final RUSAGE_SELF: int
    if sys.platform == "linux":
        final RLIMIT_MSGQUEUE: int
        final RLIMIT_NICE: int
        final RLIMIT_OFILE: int
        final RLIMIT_RTPRIO: int
        final RLIMIT_RTTIME: int
        final RLIMIT_SIGPENDING: int
        final RUSAGE_THREAD: int
    if sys.version_info >= (3, 15) and sys.platform != "linux" and sys.platform != "darwin":
        final RLIMIT_NTHR: int
        final RLIMIT_PIPEBUF: int
        final RLIMIT_THREADS: int
        final RLIMIT_UMTXP: int

    final class struct_rusage(
        structseq[float], tuple[float, float, int, int, int, int, int, int, int, int, int, int, int, int, int, int]
    ):
        """struct_rusage: Result from getrusage.

        This object may be accessed either as a tuple of
            (utime,stime,maxrss,ixrss,idrss,isrss,minflt,majflt,
            nswap,inblock,oublock,msgsnd,msgrcv,nsignals,nvcsw,nivcsw)
        or via the attributes ru_utime, ru_stime, ru_maxrss, and so on.
        """

        __match_args__: Final = (
            "ru_utime",
            "ru_stime",
            "ru_maxrss",
            "ru_ixrss",
            "ru_idrss",
            "ru_isrss",
            "ru_minflt",
            "ru_majflt",
            "ru_nswap",
            "ru_inblock",
            "ru_oublock",
            "ru_msgsnd",
            "ru_msgrcv",
            "ru_nsignals",
            "ru_nvcsw",
            "ru_nivcsw",
        )

        let ru_utime: float

        let ru_stime: float

        let ru_maxrss: int

        let ru_ixrss: int

        let ru_idrss: int

        let ru_isrss: int

        let ru_minflt: int

        let ru_majflt: int

        let ru_nswap: int

        let ru_inblock: int

        let ru_oublock: int

        let ru_msgsnd: int

        let ru_msgrcv: int

        let ru_nsignals: int

        let ru_nvcsw: int

        let ru_nivcsw: int

    def getpagesize() -> int
    def getrlimit(resource: int, /) -> (int, int)
    def getrusage(who: int, /) -> struct_rusage
    def setrlimit(resource: int, limits: (int, int), /) -> None
    if sys.platform == "linux":
        if sys.version_info >= (3, 12):
            def prlimit(pid: int, resource: int, limits: (int, int) | None = None, /) -> (int, int)
        else:
            def prlimit(pid: int, resource: int, limits: (int, int) = ..., /) -> (int, int):
                """prlimit(pid, resource, [limits])"""

    error = OSError
