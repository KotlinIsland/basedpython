"""Various Windows specific bits and pieces."""

import subprocess
import sys
from collections.abc import Callable
from types import TracebackType
from typing import Final
from typing_extensions import Self

if sys.platform == "win32":
    __all__ = ("pipe", "Popen", "PIPE", "PipeHandle")

    BUFSIZE: Final = 8192
    PIPE: Final = subprocess.PIPE
    STDOUT: Final = subprocess.STDOUT
    def pipe(*, duplex: bool = False, overlapped: (bool, bool) = (True, True), bufsize: int = 8192) -> (int, int):
        """Like os.pipe() but with overlapped support and using handles not fds."""

    class PipeHandle:
        """Wrapper for an overlapped pipe handle which is vaguely file-object like.

        The IOCP event loop can use these instead of socket objects.
        """

        init(self, handle: int)
        def __del__(self)
        def __enter__(self) -> Self
        def __exit__(self, t: type[BaseException]?, v: BaseException?, tb: TracebackType?)
        let handle: int
        def fileno(self) -> int
        def close(self, *, CloseHandle: (int) -> object = ...)

    class Popen(subprocess.Popen[AnyStr]):
        """Replacement for subprocess.Popen using overlapped pipe handles.

        The stdin, stdout, stderr are None or instances of PipeHandle.
        """

        stdin: PipeHandle?
        stdout: PipeHandle?
        stderr: PipeHandle?
        # For simplicity we omit the full overloaded __new__ signature of
        # subprocess.Popen. The arguments are mostly the same, but
        # subprocess.Popen takes other positional-or-keyword arguments before
        # stdin.
        def __new__(
            cls,
            args: subprocess._CMD,
            stdin: subprocess._FILE? = None,
            stdout: subprocess._FILE? = None,
            stderr: subprocess._FILE? = None,
            **kwds: dynamic,
        ) -> Self
        init(
            self,
            args: subprocess._CMD,
            stdin: subprocess._FILE? = None,
            stdout: subprocess._FILE? = None,
            stderr: subprocess._FILE? = None,
            **kwds: dynamic,
        )
