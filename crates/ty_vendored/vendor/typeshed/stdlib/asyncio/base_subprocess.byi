import subprocess
from collections import deque
from collections.abc import Sequence
from typing import TypeAlias

from . import events, futures, protocols, transports

type _File = int | IO[dynamic] | None

class BaseSubprocessTransport(transports.SubprocessTransport):
    _closed: bool  # undocumented
    _protocol: protocols.SubprocessProtocol  # undocumented
    _loop: events.AbstractEventLoop  # undocumented
    _proc: subprocess.Popen[dynamic] | None  # undocumented
    _pid: int | None  # undocumented
    _returncode: int | None  # undocumented
    _exit_waiters: list[futures.Future[dynamic]]  # undocumented
    _pending_calls: deque[((...) -> dynamic, (*: dynamic))]  # undocumented
    _pipes: dict[int, _File]  # undocumented
    _finished: bool  # undocumented
    init(
        self,
        loop: events.AbstractEventLoop,
        protocol: protocols.SubprocessProtocol,
        args: str | bytes | Sequence[str | bytes],
        shell: bool,
        stdin: _File,
        stdout: _File,
        stderr: _File,
        bufsize: int,
        waiter: futures.Future[dynamic] | None = None,
        extra: dynamic | None = None,
        **kwargs: dynamic,
    )
    def _start(
        self,
        args: str | bytes | Sequence[str | bytes],
        shell: bool,
        stdin: _File,
        stdout: _File,
        stderr: _File,
        bufsize: int,
        **kwargs: dynamic,
    )  # undocumented
    override def get_pid(self) -> int | None
    override def get_pipe_transport(self, fd: int) -> _File
    def _check_proc(self)  # undocumented
    override def send_signal(self, signal: int)
    async def _connect_pipes(self, waiter: futures.Future[dynamic] | None) -> None  # undocumented
    def _call(self, cb: (...) -> object, *data: dynamic)  # undocumented
    def _pipe_connection_lost(self, fd: int, exc: BaseException | None)  # undocumented
    def _pipe_data_received(self, fd: int, data: bytes)  # undocumented
    def _process_exited(self, returncode: int)  # undocumented
    async def _wait(self) -> int:  # undocumented
        """Wait until the process exit and return the process return code.

        This method is a coroutine.
        """

    def _try_finish(self)  # undocumented
    def _call_connection_lost(self, exc: BaseException | None)  # undocumented
    def __del__(self)

class WriteSubprocessPipeProto(protocols.BaseProtocol):  # undocumented
    init(self, proc: BaseSubprocessTransport, fd: int)

protocol ReadSubprocessPipeProto(WriteSubprocessPipeProto)  # undocumented
