import sys
from _typeshed import SupportsRead
from collections.abc import Callable
from typing_extensions import deprecated

__all__ = ("loads", "load", "TOMLDecodeError")

if sys.version_info >= (3, 14):
    class TOMLDecodeError(ValueError):
        """An error raised if a document is not valid TOML.

        Adds the following attributes to ValueError:
        msg: The unformatted error message
        doc: The TOML document being parsed
        pos: The index of doc where parsing failed
        lineno: The line corresponding to pos
        colno: The column corresponding to pos
        """

        msg: str
        doc: str
        pos: int
        lineno: int
        colno: int

        def __init__(self, msg: str, doc: str, pos: int) -> None
        @deprecated("Deprecated since Python 3.14. Set the 'msg', 'doc' and 'pos' arguments only.")
        def __init__(self, msg: str | type = ..., doc: str | type = ..., pos: int | type = ..., *args: dynamic) -> None

else:
    class TOMLDecodeError(ValueError):
        """An error raised if a document is not valid TOML."""

def load(fp: SupportsRead[bytes], /, *, parse_float: Callable[[str], dynamic] = ...) -> dict[str, dynamic]:
    """Parse TOML from a binary file object."""

def loads(s: str, /, *, parse_float: Callable[[str], dynamic] = ...) -> dict[str, dynamic]:
    """Parse TOML from a string."""
