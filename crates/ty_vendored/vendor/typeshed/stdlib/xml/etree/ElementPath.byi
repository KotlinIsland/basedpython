from collections.abc import Callable, Generator, Iterable
from re import Pattern
from typing import Final, Literal, TypeAlias, TypeVar
from xml.etree.ElementTree import Element

final xpath_tokenizer_re: Pattern[str]

type _Token = tuple[str, str]
type _Next = () -> _Token
type _Callback = (_SelectorContext, Iterable[Element]) -> Generator[Element]

def xpath_tokenizer(pattern: str, namespaces: dict[str, str] | None = None) -> Generator[_Token]
def get_parent_map(context: _SelectorContext) -> dict[Element, Element]
def prepare_child(next: _Next, token: _Token) -> _Callback
def prepare_star(next: _Next, token: _Token) -> _Callback
def prepare_self(next: _Next, token: _Token) -> _Callback
def prepare_descendant(next: _Next, token: _Token) -> _Callback | None
def prepare_parent(next: _Next, token: _Token) -> _Callback
def prepare_predicate(next: _Next, token: _Token) -> _Callback | None

final ops: dict[str, (_Next, _Token) -> (_Callback | None)]

class _SelectorContext:
    parent_map: dict[Element, Element] | None
    root: Element
    init(self, root: Element)

def iterfind(
    elem: Element[dynamic], path: "", namespaces: dict[str, str] | None = None
) -> None
def iterfind(elem: Element[dynamic], path: str, namespaces: dict[str, str] | None = None) -> Generator[Element]

def find(elem: Element[dynamic], path: str, namespaces: dict[str, str] | None = None) -> Element | None
def findall(elem: Element[dynamic], path: str, namespaces: dict[str, str] | None = None) -> list[Element]

def findtext(elem: Element[dynamic], path: str, default: None = None, namespaces: dict[str, str] | None = None) -> str | None
def findtext[Element](elem: Element[dynamic], path: str, default: Element, namespaces: dict[str, str] | None = None) -> Element | str
