from _typeshed import FileDescriptorOrPath
from typing import Final, Literal, Protocol, type_check_only
from xml.etree.ElementTree import Element

@type_check_only
private protocol Loader:
    def __call__(self, href: FileDescriptorOrPath, parse: "xml", encoding: str? = None) -> Element
    def __call__(self, href: FileDescriptorOrPath, parse: "text", encoding: str? = None) -> str

XINCLUDE: Final = "{http://www.w3.org/2001/XInclude}"

XINCLUDE_INCLUDE: Final = "{http://www.w3.org/2001/XInclude}include"
XINCLUDE_FALLBACK: Final = "{http://www.w3.org/2001/XInclude}fallback"

DEFAULT_MAX_INCLUSION_DEPTH: Final = 6

class FatalIncludeError(SyntaxError)

def default_loader(href: FileDescriptorOrPath, parse: "xml", encoding: str? = None) -> Element
def default_loader(href: FileDescriptorOrPath, parse: "text", encoding: str? = None) -> str

def include(elem: Element, loader: Loader? = None, base_url: str? = None, max_depth: int? = 6)

class LimitedRecursiveIncludeError(FatalIncludeError)
