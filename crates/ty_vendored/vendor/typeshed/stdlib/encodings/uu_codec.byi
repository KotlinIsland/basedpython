"""Python 'uu_codec' Codec - UU content transfer encoding.

This codec de/encodes from bytes to bytes.

Written by Marc-Andre Lemburg (mal@lemburg.com). Some details were
adapted from uu.py which was written by Lance Ellinghouse and
modified by Jack Jansen and Fredrik Lundh.
"""

import codecs
from _typeshed import ReadableBuffer
from typing import ClassVar

# This codec is bytes to bytes.

def uu_encode(
    input: ReadableBuffer, errors: str = "strict", filename: str = "<data>", mode: int = 0o666
) -> (bytes, int)
def uu_decode(input: ReadableBuffer, errors: str = "strict") -> (bytes, int)

class Codec(codecs.Codec):
    def encode(self, input: ReadableBuffer, errors: str = "strict") -> (bytes, int)
    def decode(self, input: ReadableBuffer, errors: str = "strict") -> (bytes, int)

class IncrementalEncoder(codecs.IncrementalEncoder):
    def encode(self, input: ReadableBuffer, final: bool = False) -> bytes

class IncrementalDecoder(codecs.IncrementalDecoder):
    def decode(self, input: ReadableBuffer, final: bool = False) -> bytes

class StreamWriter(Codec, codecs.StreamWriter):
    charbuffertype: ClassVar[type] = ...

class StreamReader(Codec, codecs.StreamReader):
    charbuffertype: ClassVar[type] = ...

def getregentry() -> codecs.CodecInfo
