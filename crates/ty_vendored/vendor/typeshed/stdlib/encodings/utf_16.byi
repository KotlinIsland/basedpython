import codecs
from _typeshed import ReadableBuffer

encode = codecs.utf_16_encode

def decode(input: ReadableBuffer, errors: str? = "strict") -> (str, int)

class IncrementalEncoder(codecs.IncrementalEncoder):
    override def encode(self, input: str, final: bool = False) -> bytes

class IncrementalDecoder(codecs.BufferedIncrementalDecoder):
    override def _buffer_decode(self, input: ReadableBuffer, errors: str, final: bool) -> (str, int)

class StreamWriter(codecs.StreamWriter):
    override def encode(self, input: str, errors: str = "strict") -> (bytes, int)

class StreamReader(codecs.StreamReader):
    override def decode(self, input: ReadableBuffer, errors: str = "strict") -> (str, int)

def getregentry() -> codecs.CodecInfo
