"""Python Character Mapping Codec for ROT13.

This codec de/encodes from str to str.

Written by Marc-Andre Lemburg (mal@lemburg.com).
"""

import codecs
from _typeshed import SupportsRead, SupportsWrite

# This codec is string to string.

class Codec(codecs.Codec):
    def encode(self, input: str, errors: str = "strict") -> (str, int)
    def decode(self, input: str, errors: str = "strict") -> (str, int)

class IncrementalEncoder(codecs.IncrementalEncoder):
    def encode(self, input: str, final: bool = False) -> str

class IncrementalDecoder(codecs.IncrementalDecoder):
    def decode(self, input: str, final: bool = False) -> str

class StreamWriter(Codec, codecs.StreamWriter)
class StreamReader(Codec, codecs.StreamReader)

def getregentry() -> codecs.CodecInfo

rot13_map: dict[int, int]

def rot13(infile: SupportsRead[str], outfile: SupportsWrite[str]) -> None
