final XML_ERROR_JUNK_AFTER_DOC_ELEMENT: literal str
final XML_ERROR_MISPLACED_XML_PI: literal str
final XML_ERROR_NOT_STANDALONE: literal str
final XML_ERROR_NOT_SUSPENDED: literal str
