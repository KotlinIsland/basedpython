"""Constants used to describe error conditions."""

import sys
from typing import Final
from typing_extensions import LiteralString

codes: dict[str, int]
messages: dict[int, str]

final XML_ERROR_ABORTED: LiteralString
final XML_ERROR_ASYNC_ENTITY: LiteralString
final XML_ERROR_ATTRIBUTE_EXTERNAL_ENTITY_REF: LiteralString
