"""This module makes available standard errno system symbols.

The value of each symbol is the corresponding integer value,
e.g., on most systems, errno.ENOENT equals the integer 2.

The dictionary errno.errorcode maps numeric codes to symbol names,
e.g., errno.errorcode[2] could be the string 'ENOENT'.

Symbols that are not relevant to the underlying system are not defined.

To map error codes to error messages, use the function os.strerror(),
e.g. os.strerror(2) could return 'No such file or directory'.
"""

import sys
from collections.abc import Mapping
from typing import Final

errorcode: Mapping[int, str]

final EPERM: int
final ENOENT: int
final ESRCH: int
final EINTR: int
final EIO: int
final ENXIO: int
final E2BIG: int
final ENOEXEC: int
final EBADF: int
final ECHILD: int
final EAGAIN: int
final ENOMEM: int
final EACCES: int
final EFAULT: int
final EBUSY: int
final EEXIST: int
final EXDEV: int
final ENODEV: int
final ENOTDIR: int
final EISDIR: int
final EINVAL: int
final ENFILE: int
final EMFILE: int
final ENOTTY: int
final ETXTBSY: int
final EFBIG: int
final ENOSPC: int
final ESPIPE: int
final EROFS: int
final EMLINK: int
final EPIPE: int
final EDOM: int
final ERANGE: int
final EDEADLK: int
final ENAMETOOLONG: int
final ENOLCK: int
