    final WSAEOPNOTSUPP: int
    final WSAEPFNOSUPPORT: int
    final WSAEPROCLIM: int
    final WSAEPROTONOSUPPORT: int
    final WSAEPROTOTYPE: int
    final WSAEREMOTE: int
    final WSAESHUTDOWN: int
    final WSAESOCKTNOSUPPORT: int
