final EOPNOTSUPP: int
final EPFNOSUPPORT: int
final EAFNOSUPPORT: int
final EADDRINUSE: int
final EADDRNOTAVAIL: int
final ENETDOWN: int
final ENETUNREACH: int
final ENETRESET: int
final ECONNABORTED: int
final ECONNRESET: int
final ENOBUFS: int
final EISCONN: int
final ENOTCONN: int
final ESHUTDOWN: int
final ETOOMANYREFS: int
final ETIMEDOUT: int
final ECONNREFUSED: int
final EHOSTDOWN: int
final EHOSTUNREACH: int
final EALREADY: int
final EINPROGRESS: int
final ESTALE: int
final EDQUOT: int
final ECANCELED: int  # undocumented
final ENOTRECOVERABLE: int  # undocumented
final EOWNERDEAD: int  # undocumented

if sys.platform == "sunos5" or sys.platform == "solaris":  # noqa: Y008
    final ELOCKUNMAPPED: int
    final ENOTACTIVE: int

if sys.platform != "win32":
    final ENOTBLK: int
    final EMULTIHOP: int

if sys.platform == "darwin":
    # All of the below are undocumented
    final EAUTH: int
    final EBADARCH: int
    final EBADEXEC: int
    final EBADMACHO: int
    final EBADRPC: int
    final EDEVERR: int
    final EFTYPE: int
    final ENEEDAUTH: int
    final ENOATTR: int
    final ENOPOLICY: int
    final EPROCLIM: int
    final EPROCUNAVAIL: int
    final EPROGMISMATCH: int
    final EPROGUNAVAIL: int
    final EPWROFF: int
    final ERPCMISMATCH: int
    final ESHLIBVERS: int
    if sys.version_info >= (3, 11):
        final EQFULL: int
        final ENOTCAPABLE: int  # available starting with 3.11.1

if sys.platform != "darwin":
    final EDEADLOCK: int

if sys.platform != "win32" and sys.platform != "darwin":
    final ECHRNG: int
    final EL2NSYNC: int
    final EL3HLT: int
    final EL3RST: int
    final ELNRNG: int
    final EUNATCH: int
    final ENOCSI: int
    final EL2HLT: int
    final EBADE: int
    final EBADR: int
    final EXFULL: int
    final ENOANO: int
    final EBADRQC: int
    final EBADSLT: int
    final EBFONT: int
    final ENONET: int
    final ENOPKG: int
    final EADV: int
    final ESRMNT: int
    final ECOMM: int
    final EDOTDOT: int
    final ENOTUNIQ: int
    final EBADFD: int
    final EREMCHG: int
    final ELIBACC: int
    final ELIBBAD: int
    final ELIBSCN: int
    final ELIBMAX: int
    final ELIBEXEC: int
    final ERESTART: int
    final ESTRPIPE: int
    final EUCLEAN: int
    final ENOTNAM: int
    final ENAVAIL: int
    final EISNAM: int
    final EREMOTEIO: int
    # All of the below are undocumented
    final EKEYEXPIRED: int
    final EKEYREJECTED: int
    final EKEYREVOKED: int
    final EMEDIUMTYPE: int
    final ENOKEY: int
    final ENOMEDIUM: int
    final ERFKILL: int

    if sys.version_info >= (3, 14):
        final EHWPOISON: int

if sys.platform == "win32":
