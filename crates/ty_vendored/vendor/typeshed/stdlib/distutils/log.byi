"""A simple log mechanism styled after PEP 282."""

from typing import Final

DEBUG: Final = 1
INFO: Final = 2
WARN: Final = 3
ERROR: Final = 4
FATAL: Final = 5

class Log:
    init(self, threshold: int = 3)
    # Arbitrary msg args' type depends on the format method
    def log(self, level: int, msg: str, *args: dynamic) -> None
    def debug(self, msg: str, *args: dynamic) -> None
    def info(self, msg: str, *args: dynamic) -> None
    def warn(self, msg: str, *args: dynamic) -> None
    def error(self, msg: str, *args: dynamic) -> None
    def fatal(self, msg: str, *args: dynamic) -> None

def log(level: int, msg: str, *args: dynamic) -> None
def debug(msg: str, *args: dynamic) -> None
def info(msg: str, *args: dynamic) -> None
def warn(msg: str, *args: dynamic) -> None
def error(msg: str, *args: dynamic) -> None
def fatal(msg: str, *args: dynamic) -> None
def set_threshold(level: int) -> int
def set_verbosity(v: int) -> None
