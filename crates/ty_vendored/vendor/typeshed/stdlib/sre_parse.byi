"""Internal support module for sre"""

import sys
from collections.abc import Iterable
from re import Match, Pattern as _Pattern
from sre_constants import *
from sre_constants import _NamedIntConstant as _NIC, error as _Error
from typing import Final, TypeAlias

SPECIAL_CHARS: Final = ".\\[{()*+?^$|"
REPEAT_CHARS: Final = "*+?{"
final DIGITS: frozenset[str]
final OCTDIGITS: frozenset[str]
final HEXDIGITS: frozenset[str]
final ASCIILETTERS: frozenset[str]
final WHITESPACE: frozenset[str]
final ESCAPES: dict[str, (_NIC, int)]
final CATEGORIES: dict[str, (_NIC, _NIC) | (_NIC, list[(_NIC, _NIC)])]
final FLAGS: dict[str, int]
final TYPE_FLAGS: int
final GLOBAL_FLAGS: int

if sys.version_info >= (3, 11):
    final MAXWIDTH: int

if sys.version_info < (3, 11):
    class Verbose(Exception)

private type OpSubpatternType = (int?, int, int, SubPattern)
private type OpGroupRefExistsType = (int, SubPattern, SubPattern)
private type OpInType = list[(_NIC, int)]
private type OpBranchType = (None, list[SubPattern])
private type AvType = OpInType | OpBranchType | Iterable[SubPattern] | OpGroupRefExistsType | OpSubpatternType
private type CodeType = (_NIC, AvType)

class State:
    flags: int
    groupdict: dict[str, int]
    groupwidths: list[int?]
    lookbehindgroups: int?
    let groups: int
    def opengroup(self, name: str? = None) -> int
    def closegroup(self, gid: int, p: SubPattern)
    def checkgroup(self, gid: int) -> bool
    def checklookbehindgroup(self, gid: int, source: Tokenizer)

class SubPattern:
    data: list[CodeType]
    width: int?
    state: State

    init(self, state: State, data: list[CodeType]? = None)
    def dump(self, level: int = 0)
    def __len__(self) -> int
    def __delitem__(self, index: int | slice)
    def __getitem__(self, index: int | slice) -> SubPattern | CodeType
    def __setitem__(self, index: int | slice, code: CodeType)
    def insert(self, index: int, code: CodeType)
    def append(self, code: CodeType)
    def getwidth(self) -> (int, int)

class Tokenizer:
    istext: bool
    string: dynamic
    decoded_string: str
    index: int
    next: str?
    init(self, string: dynamic)
    def match(self, char: str) -> bool
    def get(self) -> str?
    def getwhile(self, n: int, charset: Iterable[str]) -> str
    def getuntil(self, terminator: str, name: str) -> str
    let pos: int
    def tell(self) -> int
    def seek(self, index: int)
    def error(self, msg: str, offset: int = 0) -> _Error

    if sys.version_info >= (3, 12):
        def checkgroupname(self, name: str, offset: int) -> None
    elif sys.version_info >= (3, 11):
        def checkgroupname(self, name: str, offset: int, nested: int) -> None

def fix_flags(src: str | bytes, flags: int) -> int

private type TemplateType = (list[(int, int)], list[str?])
private type TemplateByteType = (list[(int, int)], list[bytes?])

if sys.version_info >= (3, 12):
    def parse_template(source: str, pattern: _Pattern[dynamic]) -> TemplateType
    def parse_template(source: bytes, pattern: _Pattern[dynamic]) -> TemplateByteType
else:
    def parse_template(source: str, state: _Pattern[dynamic]) -> TemplateType
    def parse_template(source: bytes, state: _Pattern[dynamic]) -> TemplateByteType

def parse(str: str, flags: int = 0, state: State? = None) -> SubPattern

if sys.version_info < (3, 12):
    def expand_template(template: TemplateType, match: Match[dynamic]) -> str
