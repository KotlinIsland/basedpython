"""
opcode module - potentially shared between dis and other modules which
operate on bytecodes (e.g. peephole optimizers).
"""

import sys
from typing import Final, Literal

if sys.version_info >= (3, 15):
    from builtins import frozendict

__all__ = [
    "cmp_op",
    "hasconst",
    "hasname",
    "hasjrel",
    "hasjabs",
    "haslocal",
    "hascompare",
    "hasfree",
    "opname",
    "opmap",
    "HAVE_ARGUMENT",
    "EXTENDED_ARG",
    "stack_effect",
]
if sys.version_info >= (3, 12):
    __all__ += ["hasarg", "hasexc"]
else:
    __all__ += ["hasnargs"]
if sys.version_info >= (3, 13):
    __all__ += ["hasjump"]

cmp_op: ("<", "<=", "==", "!=", ">", ">=")
final hasconst: list[int]
final hasname: list[int]
final hasjrel: list[int]
final hasjabs: list[int]
final haslocal: list[int]
final hascompare: list[int]
final hasfree: list[int]
if sys.version_info >= (3, 12):
    final hasarg: list[int]
    final hasexc: list[int]
else:
    final hasnargs: list[int]
if sys.version_info >= (3, 13):
    final hasjump: list[int]
final opname: list[str]

if sys.version_info >= (3, 15):
    final opmap: frozendict[str, int]
else:
    final opmap: dict[str, int]
final HAVE_ARGUMENT: int
final EXTENDED_ARG: int

def stack_effect(opcode: int, oparg: int | None = None, /, *, jump: bool | None = None) -> int:
    """Compute the stack effect of the opcode."""
