import sys
from asyncio.events import AbstractEventLoop
from collections.abc import Awaitable, Callable
from typing import ParamSpec, TypeVar

from .case import TestCase

if sys.version_info >= (3, 11):
    from contextlib import AbstractAsyncContextManager


class IsolatedAsyncioTestCase(TestCase):
    if sys.version_info >= (3, 13):
        loop_factory: (() -> AbstractEventLoop) | None = None

    async def asyncSetUp(self) -> None
    async def asyncTearDown(self) -> None
    def addAsyncCleanup[Parameters: (*: *, **: *)](self, func: (**Parameters) -> Awaitable[object], /, *args: Parameters.args, **kwargs: Parameters.kwargs)
    if sys.version_info >= (3, 11):
        async def enterAsyncContext[Element](self, cm: AbstractAsyncContextManager[Element]) -> Element:
            """Enters the supplied asynchronous context manager.

            If successful, also adds its __aexit__ method as a cleanup
            function and returns the result of the __aenter__ method.
            """

    def __del__(self)
