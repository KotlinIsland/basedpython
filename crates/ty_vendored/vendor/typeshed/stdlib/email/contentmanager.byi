from email.message import Message
from typing import Any

class ContentManager:
    def get_content(self, msg: Message, *args: dynamic, **kw: dynamic) -> dynamic
    def set_content(self, msg: Message, obj: dynamic, *args: dynamic, **kw: dynamic) -> dynamic
    def add_get_handler(self, key: str, handler: (...) -> Any) -> None
    def add_set_handler(self, typekey: type, handler: (...) -> Any) -> None

raw_data_manager: ContentManager
