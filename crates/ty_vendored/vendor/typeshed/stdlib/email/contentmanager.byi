from _typeshed import Incomplete
from email.message import Message

class ContentManager:
    def get_content(self, msg: Message, *args, **kw)
    def set_content(self, msg: Message, obj, *args, **kw)
    def add_get_handler(self, key: str, handler: (...) -> Incomplete)
    def add_set_handler(self, typekey: type, handler: (...) -> Incomplete)

raw_data_manager: ContentManager
