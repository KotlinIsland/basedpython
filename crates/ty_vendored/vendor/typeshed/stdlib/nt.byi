"""This module provides access to operating system functionality that is
standardized by the C Standard and the POSIX standard (a thinly
disguised Unix interface).  Refer to the library manual and
corresponding Unix manual entries for more information on calls.
"""

import sys

if sys.platform == "win32":
    # Actually defined here and re-exported from os at runtime,
    # but this leads to less code duplication
    from os export (
        F_OK,
        O_APPEND,
        O_BINARY,
        O_CREAT,
        O_EXCL,
        O_NOINHERIT,
        O_RANDOM,
        O_RDONLY,
        O_RDWR,
        O_SEQUENTIAL,
        O_SHORT_LIVED,
        O_TEMPORARY,
        O_TEXT,
        O_TRUNC,
        O_WRONLY,
        P_DETACH,
        P_NOWAIT,
        P_NOWAITO,
        P_OVERLAY,
        P_WAIT,
        R_OK,
        TMP_MAX,
        W_OK,
        X_OK,
        DirEntry,
        abort,
        access,
        chdir,
        chmod,
        close,
        closerange,
        cpu_count,
        device_encoding,
        dup,
        dup2,
        error,
        execv,
        execve,
        fspath,
        fstat,
        fsync,
        ftruncate,
        get_handle_inheritable,
        get_inheritable,
        get_terminal_size,
        getcwd,
        getcwdb,
        getlogin,
        getpid,
        getppid,
        isatty,
        kill,
        link,
        listdir,
        lseek,
        lstat,
        mkdir,
        open,
        pipe,
        putenv,
        read,
        readlink,
        remove,
        rename,
        replace,
        rmdir,
        scandir,
        set_handle_inheritable,
        set_inheritable,
        spawnv,
        spawnve,
        startfile,
        stat,
        stat_result,
        statvfs_result,
        strerror,
        symlink,
        system,
        terminal_size,
        times,
        times_result,
        truncate,
        umask,
        uname_result,
        unlink,
        unsetenv,
        urandom,
        utime,
        waitpid,
        waitstatus_to_exitcode,
        write,
    )

    if sys.version_info >= (3, 11):
        from os export EX_OK
    if sys.version_info >= (3, 12):
        from os export (
            get_blocking,
            listdrives,
            listmounts,
            listvolumes,
            set_blocking,
        )
    if sys.version_info >= (3, 13):
        from os export fchmod, lchmod

    if sys.version_info >= (3, 14):
        from os export readinto

    environ: dict[str, str]
