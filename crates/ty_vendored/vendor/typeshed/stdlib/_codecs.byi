import codecs
import sys
from _typeshed import ReadableBuffer
from collections.abc import Callable
from typing import Literal, TypeAlias, final, type_check_only

# This type is not exposed; it is defined in unicodeobject.c
# At runtime it calls itself builtins.EncodingMap
@type_check_only
final class _EncodingMap:
    def size(self) -> int

type _CharMap = dict[int, int] | _EncodingMap
private type Handler = (UnicodeError) -> (str | bytes, int)
private type SearchFunction = (str) -> (codecs.CodecInfo?)

def register(search_function: SearchFunction, /):
    """Register a codec search function.

    Search functions are expected to take one argument, the encoding
    name in all lower case letters, and either return None, or a tuple
    of functions (encoder, decoder, stream_reader, stream_writer) (or
    a CodecInfo object).
    """

def unregister(search_function: SearchFunction, /):
    """Unregister a codec search function and clear the registry's cache.

    If the search function is not registered, do nothing.
    """

def register_error(errors: str, handler: Handler, /):
    """Register the specified error handler under the name errors.

    handler must be a callable object, that will be called with an exception
    instance containing information about the location of the
    encoding/decoding error and must return a (replacement, new position)
    tuple.
    """

def lookup_error(name: str, /) -> Handler:
    """lookup_error(errors) -> handler

    Return the error handler for the specified error handling name or raise
    a LookupError, if no handler exists under this name.
    """

# The type ignore on `encode` and `decode` is to avoid issues with overlapping overloads, for more details, see #300
# https://docs.python.org/3/library/codecs.html#binary-transforms
private type BytesToBytesEncoding = "base64" | "base_64" | "base64_codec" | "bz2" | "bz2_codec" | "hex" | "hex_codec" | "quopri" | "quotedprintable" | "quoted_printable" | "quopri_codec" | "uu" | "uu_codec" | "zip" | "zlib" | "zlib_codec"
# https://docs.python.org/3/library/codecs.html#text-transforms
private type StrToStrEncoding = "rot13" | "rot_13"

def encode(obj: ReadableBuffer, encoding: BytesToBytesEncoding, errors: str = "strict") -> bytes:
    """Encodes obj using the codec registered for encoding.

    The default encoding is 'utf-8'.  errors may be given to set a
    different error handling scheme.  Default is 'strict' meaning that
    encoding errors raise a ValueError.  Other possible values are 'ignore',
    'replace' and 'backslashreplace' as well as any other name registered
    with codecs.register_error that can handle ValueErrors.
    """
def encode(obj: str, encoding: StrToStrEncoding, errors: str = "strict") -> str
def encode(obj: str, encoding: str = "utf-8", errors: str = "strict") -> bytes

def decode(obj: ReadableBuffer, encoding: BytesToBytesEncoding, errors: str = "strict") -> bytes:
    """Decodes obj using the codec registered for encoding.

    Default encoding is 'utf-8'.  errors may be given to set a
    different error handling scheme.  Default is 'strict' meaning that
    encoding errors raise a ValueError.  Other possible values are 'ignore',
    'replace' and 'backslashreplace' as well as any other name registered
    with codecs.register_error that can handle ValueErrors.
    """
def decode(obj: str, encoding: StrToStrEncoding, errors: str = "strict") -> str

# these are documented as text encodings but in practice they also accept str as input
def decode(
    obj: str,
    encoding: "unicode_escape" | "unicode-escape" | "raw_unicode_escape" | "raw-unicode-escape",
    errors: str = "strict",
) -> str

# hex is officially documented as a bytes to bytes encoding, but it appears to also work with str
def decode(obj: str, encoding: "hex" | "hex_codec", errors: str = "strict") -> bytes
def decode(obj: ReadableBuffer, encoding: str = "utf-8", errors: str = "strict") -> str

def lookup(encoding: str, /) -> codecs.CodecInfo:
    """Looks up a codec tuple in the Python codec registry and returns a CodecInfo object."""

def charmap_build(map: str, /) -> _CharMap
def ascii_decode(data: ReadableBuffer, errors: str? = None, /) -> (str, int)
def ascii_encode(str: str, errors: str? = None, /) -> (bytes, int)
def charmap_decode(data: ReadableBuffer, errors: str? = None, mapping: _CharMap? = None, /) -> (str, int)
def charmap_encode(str: str, errors: str? = None, mapping: _CharMap? = None, /) -> (bytes, int)

# Docs say this accepts a bytes-like object, but in practice it also accepts str.
def escape_decode(data: str | ReadableBuffer, errors: str? = None, /) -> (bytes, int)
def escape_encode(data: bytes, errors: str? = None, /) -> (bytes, int)
def latin_1_decode(data: ReadableBuffer, errors: str? = None, /) -> (str, int)
def latin_1_encode(str: str, errors: str? = None, /) -> (bytes, int)
def raw_unicode_escape_decode(
    data: str | ReadableBuffer, errors: str? = None, final: bool = True, /
) -> (str, int)
def raw_unicode_escape_encode(str: str, errors: str? = None, /) -> (bytes, int)
def readbuffer_encode(data: str | ReadableBuffer, errors: str? = None, /) -> (bytes, int)
def unicode_escape_decode(data: str | ReadableBuffer, errors: str? = None, final: bool = True, /) -> (str, int)
def unicode_escape_encode(str: str, errors: str? = None, /) -> (bytes, int)
def utf_16_be_decode(data: ReadableBuffer, errors: str? = None, final: bool = False, /) -> (str, int)
def utf_16_be_encode(str: str, errors: str? = None, /) -> (bytes, int)
def utf_16_decode(data: ReadableBuffer, errors: str? = None, final: bool = False, /) -> (str, int)
def utf_16_encode(str: str, errors: str? = None, byteorder: int = 0, /) -> (bytes, int)
def utf_16_ex_decode(
    data: ReadableBuffer, errors: str? = None, byteorder: int = 0, final: bool = False, /
) -> (str, int, int)
def utf_16_le_decode(data: ReadableBuffer, errors: str? = None, final: bool = False, /) -> (str, int)
def utf_16_le_encode(str: str, errors: str? = None, /) -> (bytes, int)
def utf_32_be_decode(data: ReadableBuffer, errors: str? = None, final: bool = False, /) -> (str, int)
def utf_32_be_encode(str: str, errors: str? = None, /) -> (bytes, int)
def utf_32_decode(data: ReadableBuffer, errors: str? = None, final: bool = False, /) -> (str, int)
def utf_32_encode(str: str, errors: str? = None, byteorder: int = 0, /) -> (bytes, int)
def utf_32_ex_decode(
    data: ReadableBuffer, errors: str? = None, byteorder: int = 0, final: bool = False, /
) -> (str, int, int)
def utf_32_le_decode(data: ReadableBuffer, errors: str? = None, final: bool = False, /) -> (str, int)
def utf_32_le_encode(str: str, errors: str? = None, /) -> (bytes, int)
def utf_7_decode(data: ReadableBuffer, errors: str? = None, final: bool = False, /) -> (str, int)
def utf_7_encode(str: str, errors: str? = None, /) -> (bytes, int)
def utf_8_decode(data: ReadableBuffer, errors: str? = None, final: bool = False, /) -> (str, int)
def utf_8_encode(str: str, errors: str? = None, /) -> (bytes, int)

if sys.platform == "win32":
    def mbcs_decode(data: ReadableBuffer, errors: str? = None, final: bool = False, /) -> (str, int)
    def mbcs_encode(str: str, errors: str? = None, /) -> (bytes, int)
    def code_page_decode(
        codepage: int, data: ReadableBuffer, errors: str? = None, final: bool = False, /
    ) -> (str, int)
    def code_page_encode(code_page: int, str: str, errors: str? = None, /) -> (bytes, int)
    def oem_decode(data: ReadableBuffer, errors: str? = None, final: bool = False, /) -> (str, int)
    def oem_encode(str: str, errors: str? = None, /) -> (bytes, int)
