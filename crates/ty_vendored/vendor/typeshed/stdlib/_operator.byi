"""Operator interface.

This module exports a set of functions implemented in C corresponding
to the intrinsic operators of Python.  For example, operator.add(x, y)
is equivalent to the expression x+y.  The function names are those
used for special methods; variants without leading and trailing
'__' are also provided for convenience.
"""

import sys
from _typeshed import (
    SupportsAdd,
    SupportsGetItem,
    SupportsMod,
    SupportsMul,
    SupportsRAdd,
    SupportsRMod,
    SupportsRMul,
    SupportsRSub,
    SupportsSub,
)
from collections.abc import Callable, Container, Iterable, MutableMapping, MutableSequence, Sequence
from operator import attrgetter as attrgetter, itemgetter as itemgetter, methodcaller as methodcaller
from typing import ParamSpec, Protocol, TypeAlias, TypeVar, type_check_only


# The following protocols return "Any" instead of bool, since the comparison
# operators can be overloaded to return an arbitrary object. For example,
# the numpy.array comparison dunders return another numpy.array.

@type_check_only
private protocol SupportsDunderLT:
    def __lt__(self, other: dynamic, /) -> dynamic

@type_check_only
private protocol SupportsDunderGT:
    def __gt__(self, other: dynamic, /) -> dynamic

@type_check_only
private protocol SupportsDunderLE:
    def __le__(self, other: dynamic, /) -> dynamic

@type_check_only
private protocol SupportsDunderGE:
    def __ge__(self, other: dynamic, /) -> dynamic

private type SupportsComparison = SupportsDunderLE | SupportsDunderGE | SupportsDunderGT | SupportsDunderLT

@type_check_only
private protocol SupportsInversion[out Element]:
    def __invert__(self) -> Element

@type_check_only
private protocol SupportsNeg[out Element]:
    def __neg__(self) -> Element

@type_check_only
private protocol SupportsPos[out Element]:
    def __pos__(self) -> Element

# All four comparison functions must have the same signature, or we get false-positive errors
def lt(a: SupportsComparison, b: SupportsComparison, /) -> dynamic:
    """Same as a < b."""

def le(a: SupportsComparison, b: SupportsComparison, /) -> dynamic:
    """Same as a <= b."""

def eq(a: object, b: object, /) -> dynamic:
    """Same as a == b."""

def ne(a: object, b: object, /) -> dynamic:
    """Same as a != b."""

def ge(a: SupportsComparison, b: SupportsComparison, /) -> dynamic:
    """Same as a >= b."""

def gt(a: SupportsComparison, b: SupportsComparison, /) -> dynamic:
    """Same as a > b."""

def not_(a: object, /) -> bool:
    """Same as not a."""

def truth(a: object, /) -> bool:
    """Return True if a is true, False otherwise."""

def is_(a: object, b: object, /) -> bool:
    """Same as a is b."""

def is_not(a: object, b: object, /) -> bool:
    """Same as a is not b."""

def abs[Element](a: SupportsAbs[Element], /) -> Element:
    """Same as abs(a)."""

def add[Input, Element](a: SupportsAdd[Input, Element], b: Input, /) -> Element:
    """Same as a + b."""
def add[Input, Element](a: Input, b: SupportsRAdd[Input, Element], /) -> Element

def and_(a, b, /):
    """Same as a & b."""

def floordiv(a, b, /):
    """Same as a // b."""

def index(a: SupportsIndex, /) -> int:
    """Same as a.__index__()"""

def inv[Element](a: SupportsInversion[Element], /) -> Element:
    """Same as ~a."""

def invert[Element](a: SupportsInversion[Element], /) -> Element:
    """Same as ~a."""

def lshift(a, b, /):
    """Same as a << b."""

def mod[Input, Element](a: SupportsMod[Input, Element], b: Input, /) -> Element:
    """Same as a % b."""
def mod[Input, Element](a: Input, b: SupportsRMod[Input, Element], /) -> Element

def mul[Input, Element](a: SupportsMul[Input, Element], b: Input, /) -> Element:
    """Same as a * b."""
def mul[Input, Element](a: Input, b: SupportsRMul[Input, Element], /) -> Element

def matmul(a, b, /):
    """Same as a @ b."""

def neg[Element](a: SupportsNeg[Element], /) -> Element:
    """Same as -a."""

def or_(a, b, /):
    """Same as a | b."""

def pos[Element](a: SupportsPos[Element], /) -> Element:
    """Same as +a."""

def pow(a, b, /):
    """Same as a ** b."""

def rshift(a, b, /):
    """Same as a >> b."""

def sub[Input, Element](a: SupportsSub[Input, Element], b: Input, /) -> Element:
    """Same as a - b."""
def sub[Input, Element](a: Input, b: SupportsRSub[Input, Element], /) -> Element

def truediv(a, b, /):
    """Same as a / b."""

def xor(a, b, /):
    """Same as a ^ b."""

def concat[Element](a: Sequence[Element], b: Sequence[Element], /) -> Sequence[Element]:
    """Same as a + b, for a and b sequences."""

def contains(a: Container[object], b: object, /) -> bool:
    """Same as b in a (note reversed operands)."""

def countOf(a: Iterable[object], b: object, /) -> int:
    """Return the number of items in a which are, or which equal, b."""

def delitem(a: MutableSequence[dynamic], b: int, /) -> None:
    """Same as del a[b]."""
def delitem(a: MutableSequence[dynamic], b: slice[int | None], /) -> None
def delitem[K](a: MutableMapping[K, dynamic], b: K, /) -> None

def getitem[Element](a: Sequence[Element], b: slice[int | None], /) -> Sequence[Element]:
    """Same as a[b]."""
def getitem[K, V](a: SupportsGetItem[K, V], b: K, /) -> V

def indexOf[Element](a: Iterable[Element], b: Element, /) -> int:
    """Return the first index of b in a."""

def setitem[Element](a: MutableSequence[Element], b: int, c: Element, /) -> None:
    """Same as a[b] = c."""
def setitem[Element](a: MutableSequence[Element], b: slice[int | None], c: Sequence[Element], /) -> None
def setitem[K, V](a: MutableMapping[K, V], b: K, c: V, /) -> None

def length_hint(obj: object, default: int = 0, /) -> int:
    """Return an estimate of the number of items in obj.

    This is useful for presizing containers when building from an iterable.

    If the object supports len(), the result will be exact.
    Otherwise, it may over- or under-estimate by an arbitrary amount.
    The result will be an integer >= 0.
    """

def iadd(a, b, /):
    """Same as a += b."""

def iand(a, b, /):
    """Same as a &= b."""

def iconcat(a, b, /):
    """Same as a += b, for a and b sequences."""

def ifloordiv(a, b, /):
    """Same as a //= b."""

def ilshift(a, b, /):
    """Same as a <<= b."""

def imod(a, b, /):
    """Same as a %= b."""

def imul(a, b, /):
    """Same as a *= b."""

def imatmul(a, b, /):
    """Same as a @= b."""

def ior(a, b, /):
    """Same as a |= b."""

def ipow(a, b, /):
    """Same as a **= b."""

def irshift(a, b, /):
    """Same as a >>= b."""

def isub(a, b, /):
    """Same as a -= b."""

def itruediv(a, b, /):
    """Same as a /= b."""

def ixor(a, b, /):
    """Same as a ^= b."""

if sys.version_info >= (3, 11):
    def call[**P, R](obj: (**P) -> R, /, *args: P.args, **kwargs: P.kwargs) -> R:
        """Same as obj(*args, **kwargs)."""

def _compare_digest(a: AnyStr, b: AnyStr, /) -> bool:
    """Return 'a == b'.

    This function uses an approach designed to prevent
    timing analysis, making it appropriate for cryptography.

    a and b must both be of the same type: either str (ASCII only),
    or any bytes-like object.

    Note: If a and b are of different lengths, or if an error occurs,
    a timing attack could theoretically reveal information about the
    types and lengths of a and b--but not their values.
    """

if sys.version_info >= (3, 14):
    def is_none(a: object, /) -> a is None:
        """Same as a is None."""

    def is_not_none[Element](a: Element | None, /) -> a is Element:
        """Same as a is not None."""
