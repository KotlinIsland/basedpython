final TYPE_COMMENT: int
final TYPE_IGNORE: int
final COLONEQUAL: int
final EXACT_TOKEN_TYPES: dict[str, int]
final SOFT_KEYWORD: int

if sys.version_info >= (3, 12):
    final EXCLAMATION: int
    final FSTRING_END: int
    final FSTRING_MIDDLE: int
    final FSTRING_START: int

if sys.version_info >= (3, 14):
    final TSTRING_START: int
    final TSTRING_MIDDLE: int
