from multiprocessing.connection import _Address
from queue import Queue
from types import TracebackType
from typing_extensions import Self

__all__ = ["Client", "Listener", "Pipe"]

families: list[None]

class Connection:
    _in: dynamic
    _out: dynamic
    recv: dynamic
    recv_bytes: dynamic
    send: dynamic
    send_bytes: dynamic
    def __enter__(self) -> Self
    def __exit__(
        self, exc_type: type[BaseException]?, exc_value: BaseException?, exc_tb: TracebackType?
    )
    init(self, _in: dynamic, _out: dynamic)
    def close(self)
    def poll(self, timeout: int | float = 0.0) -> bool

class Listener:
    _backlog_queue: Queue[dynamic]?
    let address: Queue[dynamic]?
    def __enter__(self) -> Self
    def __exit__(
        self, exc_type: type[BaseException]?, exc_value: BaseException?, exc_tb: TracebackType?
    )
    init(self, address: _Address? = None, family: int? = None, backlog: int = 1)
    def accept(self) -> Connection
    def close(self)

def Client(address: _Address) -> Connection
def Pipe(duplex: bool = True) -> (Connection, Connection)
