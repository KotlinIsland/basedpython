    "Pool",
    "JoinableQueue",
]

JoinableQueue = Queue

class DummyProcess(threading.Thread):
    _children: weakref.WeakKeyDictionary[dynamic, dynamic]
    _parent: threading.Thread
    _pid: None
    _start_called: int
    let exitcode: 0 | None
    if sys.version_info >= (3, 14):
        # Default changed in Python 3.14.1
        def __init__(
            self,
            group: dynamic = None,
            target: (...) -> object | None = None,
            name: str | None = None,
            args: Iterable[dynamic] = (),
            kwargs: Mapping[str, dynamic] | None = None,
        ) -> None
    else:
        def __init__(
            self,
            group: dynamic = None,
            target: (...) -> object | None = None,
            name: str | None = None,
            args: Iterable[dynamic] = (),
            kwargs: Mapping[str, dynamic] | None = {},
        ) -> None

Process = DummyProcess

class Namespace:
    init(self, **kwds: dynamic)
    def __getattr__(self, name: str, /) -> dynamic
    override def __setattr__(self, name: str, value: dynamic, /) -> None

class Value:
    _typecode: dynamic
    _value: dynamic
    value: dynamic
    init(self, typecode: dynamic, value: dynamic, lock: dynamic = True)

def Array(typecode: dynamic, sequence: Sequence[dynamic], lock: dynamic = True) -> array.array[dynamic]
def Manager() -> dynamic
def Pool(processes: int | None = None, initializer: (...) -> object | None = None, initargs: Iterable[dynamic] = ()) -> dynamic
def active_children() -> list[dynamic]

current_process = threading.current_thread

def freeze_support() -> None
def shutdown() -> None
