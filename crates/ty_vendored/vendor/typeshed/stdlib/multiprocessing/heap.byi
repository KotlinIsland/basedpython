import sys
from collections.abc import Callable
from mmap import mmap
from multiprocessing import popen_forkserver, popen_spawn_posix, resource_sharer
from typing import Protocol, TypeAlias, type_check_only

__all__ = ["BufferWrapper"]

class Arena:
    """
    A shared memory area backed by a temporary file (POSIX).
    """

    size: int
    buffer: mmap
    if sys.platform == "win32":
        name: str
        def __init__(self, size: int) -> None
    else:
        fd: int
        def __init__(self, size: int, fd: int = -1) -> None

private type Block = tuple[Arena, int, int]

if sys.platform != "win32":
    @type_check_only
    protocol _SupportsDetach:
        def detach(self) -> int

    def reduce_arena(
        a: Arena,
    ) -> ((int, _SupportsDetach) -> Arena, (int, popen_forkserver._DupFd | popen_spawn_posix._DupFd | resource_sharer.DupFd))
    def rebuild_arena(size: int, dupfd: _SupportsDetach) -> Arena

class Heap:
    init(self, size: int = ...)
    def free(self, block: Block) -> None
    def malloc(self, size: int) -> Block

class BufferWrapper:
    init(self, size: int)
    def create_memoryview(self) -> memoryview
