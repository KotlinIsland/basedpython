from collections.abc import Callable, Iterable, Mapping
from multiprocessing.context import DefaultContext, Process as _Process
from types import GenericAlias, TracebackType
from typing import Final, Generic, TypeVar
from typing_extensions import Self

__all__ = ["Pool", "ThreadPool"]


class ApplyResult[in out Element]:
    init(
        self, pool: Pool, callback: ((Element) -> object) | None, error_callback: ((BaseException) -> object) | None
    )
    def get(self, timeout: int | float | None = None) -> Element
    def wait(self, timeout: int | float | None = None)
    def ready(self) -> bool
    def successful(self) -> bool
    def __class_getitem__(cls, item: dynamic, /) -> GenericAlias:
        """Represent a PEP 585 generic type

        For example, for t = list[int], t.__origin__ is list and t.__args__
        is (int,).
        """

# alias created during issue #17805
AsyncResult = ApplyResult

class MapResult[in out Element](ApplyResult[list[Element]]):
    init(
        self,
        pool: Pool,
        chunksize: int,
        length: int,
        callback: ((list[Element]) -> object) | None,
        error_callback: ((BaseException) -> object) | None,
    )

class IMapIterator[in out Element]:
    init(self, pool: Pool)
    def __iter__(self) -> Self
    def next(self, timeout: int | float | None = None) -> Element
    def __next__(self, timeout: int | float | None = None) -> Element

class IMapUnorderedIterator[in out Element](IMapIterator[Element])

class Pool:
    """
    Class which supports an async version of applying functions to arguments.
    """

    init(
        self,
        processes: int | None = None,
        initializer: (...) -> object | None = None,
        initargs: Iterable[dynamic] = (),
        maxtasksperchild: int | None = None,
        context: dynamic | None = None,
    )
    static def Process(ctx: DefaultContext, *args: dynamic, **kwds: dynamic) -> _Process
    def apply[Element](self, func: (...) -> Element, args: Iterable[dynamic] = (), kwds: Mapping[str, dynamic] = {}) -> Element:
        """
        Equivalent of `func(*args, **kwds)`.
        Pool must be running.
        """

    def apply_async[Element](
        self,
        func: (...) -> Element,
        args: Iterable[dynamic] = (),
        kwds: Mapping[str, dynamic] = {},
        callback: ((Element) -> object) | None = None,
        error_callback: ((BaseException) -> object) | None = None,
    ) -> AsyncResult[Element]:
        """
        Asynchronous version of `apply()` method.
        """

    def map[Other, Element](self, func: (Other) -> Element, iterable: Iterable[Other], chunksize: int | None = None) -> list[Element]:
        """
        Apply `func` to each element in `iterable`, collecting the results
        in a list that is returned.
        """

    def map_async[Other, Element](
        self,
        func: (Other) -> Element,
        iterable: Iterable[Other],
        chunksize: int | None = None,
        callback: ((list[Element]) -> object) | None = None,
        error_callback: ((BaseException) -> object) | None = None,
    ) -> MapResult[Element]:
        """
        Asynchronous version of `map()` method.
        """

    def imap[Other, Element](self, func: (Other) -> Element, iterable: Iterable[Other], chunksize: int | None = 1) -> IMapIterator[Element]:
        """
        Equivalent of `map()` -- can be MUCH slower than `Pool.map()`.
        """

    def imap_unordered[Other, Element](self, func: (Other) -> Element, iterable: Iterable[Other], chunksize: int | None = 1) -> IMapIterator[Element]:
        """
        Like `imap()` method but ordering of results is arbitrary.
        """

    def starmap[Element](self, func: (...) -> Element, iterable: Iterable[Iterable[dynamic]], chunksize: int | None = None) -> list[Element]:
        """
        Like `map()` method but the elements of the `iterable` are expected to
        be iterables as well and will be unpacked as arguments. Hence
        `func` and (a, b) becomes func(a, b).
        """

    def starmap_async[Element](
        self,
        func: (...) -> Element,
        iterable: Iterable[Iterable[dynamic]],
        chunksize: int | None = None,
        callback: ((list[Element]) -> object) | None = None,
        error_callback: ((BaseException) -> object) | None = None,
    ) -> AsyncResult[list[Element]]:
        """
        Asynchronous version of `starmap()` method.
        """

    def close(self)
    def terminate(self)
    def join(self)
    def __enter__(self) -> Self
    def __exit__(
        self, exc_type: type[BaseException] | None, exc_val: BaseException | None, exc_tb: TracebackType | None
    )
    def __del__(self)

class ThreadPool(Pool):
    init(
        self, processes: int | None = None, initializer: (...) -> object | None = None, initargs: Iterable[dynamic] = ()
    )

# undocumented
INIT: Final = "INIT"
RUN: Final = "RUN"
CLOSE: Final = "CLOSE"
TERMINATE: Final = "TERMINATE"
