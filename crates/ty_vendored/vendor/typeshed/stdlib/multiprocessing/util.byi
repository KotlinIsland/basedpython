import sys
import threading
from _typeshed import ConvertibleToInt, Incomplete, Unused
from collections.abc import Callable, Iterable, Mapping, MutableMapping, Sequence
from logging import Logger, _Level as _LoggingLevel
from typing import Final, Generic, TypeVar

__all__ = [
    "sub_debug",
    "debug",
    "info",
    "sub_warning",
    "get_logger",
    "log_to_stderr",
    "get_temp_dir",
    "register_after_fork",
    "is_exiting",
    "Finalize",
    "ForkAwareThreadLock",
    "ForkAwareLocal",
    "close_all_fds_except",
    "SUBDEBUG",
    "SUBWARNING",
]

if sys.version_info >= (3, 14):
    __all__ += ["warn"]


NOTSET: Final = 0
SUBDEBUG: Final = 5
DEBUG: Final = 10
INFO: Final = 20
SUBWARNING: Final = 25
if sys.version_info >= (3, 14):
    WARNING: Final = 30

final LOGGER_NAME: str
final DEFAULT_LOGGING_FORMAT: str

def sub_debug(msg: object, *args: object)
def debug(msg: object, *args: object)
def info(msg: object, *args: object)

if sys.version_info >= (3, 14):
    def warn(msg: object, *args: object)

def sub_warning(msg: object, *args: object)
def get_logger() -> Logger:
    """
    Returns logger used by multiprocessing
    """

def log_to_stderr(level: _LoggingLevel | None = None) -> Logger:
    """
    Turn on logging and add a handler which prints to stderr
    """

def is_abstract_socket_namespace(address: str | bytes | None) -> bool

final abstract_sockets_supported: bool

def get_temp_dir() -> str
def register_after_fork[Element](obj: Element, func: (Element) -> object)

class Finalize[out R = dynamic]:
    """
    Class which supports object finalization using weakrefs
    """

    # "args" and "kwargs" are passed as arguments to "callback".
    init(
        self,
        obj: None,
        callback: (...) -> R,
        *,
        args: Sequence[dynamic] = (),
        kwargs: Mapping[str, dynamic] | None = None,
        exitpriority: int,
    )
    init(
        self, obj: None, callback: (...) -> R, args: Sequence[dynamic], kwargs: Mapping[str, dynamic] | None, exitpriority: int
    )
    init(
        self,
        obj: dynamic,
        callback: (...) -> R,
        args: Sequence[dynamic] = (),
        kwargs: Mapping[str, dynamic] | None = None,
        exitpriority: int | None = None,
    )

    def __call__(
        self,
        wr: Unused = None,
        _finalizer_registry: MutableMapping[Incomplete, Incomplete] = {},
        sub_debug: (...) -> object = ...,
        getpid: () -> int = ...,
    ) -> R:
        """
        Run the callback unless it has already been called or cancelled
        """

    def cancel(self):
        """
        Cancel finalization of the object
        """

    def still_active(self) -> bool:
        """
        Return whether this finalizer is still waiting to invoke callback
        """

def is_exiting() -> bool:
    """
    Returns true if the process is shutting down
    """

class ForkAwareThreadLock:
    acquire: (bool, int | float) -> bool
    release: () -> None
    def __enter__(self) -> bool
    def __exit__(self, *args: Unused)

class ForkAwareLocal(threading.local)

final MAXFD: int

def close_all_fds_except(fds: Iterable[int])
def spawnv_passfds(path: bytes, args: Sequence[ConvertibleToInt], passfds: Sequence[int]) -> int
