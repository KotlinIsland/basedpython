import builtins
import queue
import sys
import threading
from _typeshed import SupportsKeysAndGetItem, SupportsRichComparison, SupportsRichComparisonT
from collections.abc import (
    Callable,
    Iterable,
    Iterator,
    Mapping,
    MutableMapping,
    MutableSequence,
    MutableSet,
    Sequence,
    Set as AbstractSet,
)
from types import GenericAlias, TracebackType
from typing import ClassVar, Generic, TypeAlias, TypeVar
from typing_extensions import Self

from . import pool
from .connection import Connection, _Address
from .context import BaseContext
from .shared_memory import _SLT, ShareableList as _ShareableList, SharedMemory as _SharedMemory
from .util import Finalize as _Finalize

__all__ = ["BaseManager", "SyncManager", "BaseProxy", "Token", "SharedMemoryManager"]


class Namespace:
    init(self, **kwds: dynamic)
    def __getattr__(self, name: str, /) -> dynamic
    override def __setattr__(self, name: str, value: dynamic, /)

type _Namespace = Namespace

class Token:
    """
    Type to uniquely identify a shared object
    """

    __slots__ = ("typeid", "address", "id")
    typeid: str | bytes | None
    address: _Address | None
    id: str | bytes | int | None
    init(self, typeid: bytes | str | None, address: _Address | None, id: str | bytes | int | None)
    def __getstate__(self) -> (str | bytes | None, (str | bytes, int), str | bytes | int | None)
    def __setstate__(self, state: (str | bytes | None, (str | bytes, int), str | bytes | int | None))

class BaseProxy:
    """
    A base for proxies of shared objects
    """

    _address_to_local: dict[_Address, dynamic]
    _mutex: dynamic
    init(
        self,
        token: dynamic,
        serializer: str,
        manager: dynamic = None,
        authkey: AnyStr | None = None,
        exposed: dynamic = None,
        incref: bool = True,
        manager_owned: bool = False,
    )
    def __deepcopy__(self, memo: dynamic | None) -> dynamic
    def _callmethod(self, methodname: str, args: (*: dynamic) = (), kwds: dict[dynamic, dynamic] = {}):
        """
        Try to call a method of the referent and return a copy of the result
        """

    def _getvalue(self) -> dynamic:
        """
        Get a copy of the value of the referent
        """

    override def __reduce__(self) -> (dynamic, (dynamic, dynamic, str, dict[dynamic, dynamic]))

class ValueProxy[in out Element](BaseProxy):
    def get(self) -> Element
    def set(self, value: Element)
    value: Element
    def __class_getitem__(cls, item: dynamic, /) -> GenericAlias:
        """Represent a PEP 585 generic type

        For example, for t = list[int], t.__origin__ is list and t.__args__
        is (int,).
        """

if sys.version_info >= (3, 13):
    class _BaseDictProxy[in out Key, in out Value](BaseProxy, MutableMapping[Key, Value]):
        __builtins__: ClassVar[dict[str, dynamic]]
        def __len__(self) -> int
        def __getitem__(self, key: Key, /) -> Value
        def __setitem__(self, key: Key, value: Value, /)
        def __delitem__(self, key: Key, /)
        def __iter__(self) -> Iterator[Key]
        def copy(self) -> dict[Key, Value]

        def get(self, key: Key, /) -> Value | None
        def get(self, key: Key, default: Value, /) -> Value
        def get[Element](self, key: Key, default: Element, /) -> Value | Element

        def pop(self, key: Key, /) -> Value
        def pop(self, key: Key, default: Value, /) -> Value
        def pop[Element](self, key: Key, default: Element, /) -> Value | Element

        def keys(self) -> list[Key]
        def items(self) -> list[(Key, Value)]
        def values(self) -> list[Value]
        if sys.version_info >= (3, 14):
            # Next methods are copied from builtins.dict
            def fromkeys[Element](self, iterable: Iterable[Element], value: None = None, /) -> dict[Element, dynamic | None]
            def fromkeys[Element, Other](self, iterable: Iterable[Element], value: Other, /) -> dict[Element, Other]

            def __reversed__(self) -> Iterator[Key]

            def __or__(self, value: dict[Key, Value], /) -> dict[Key, Value]
            def __or__[T1, T2](self, value: dict[T1, T2], /) -> dict[Key | T1, Value | T2]

            def __ror__(self, value: dict[Key, Value], /) -> dict[Key, Value]
            def __ror__[T1, T2](self, value: dict[T1, T2], /) -> dict[Key | T1, Value | T2]

            def __ior__(self, value: SupportsKeysAndGetItem[Key, Value], /) -> Self
            def __ior__(self, value: Iterable[(Key, Value)], /) -> Self

    class DictProxy[in out Key, in out Value](_BaseDictProxy[Key, Value]):
        def __class_getitem__(cls, args: dynamic, /) -> GenericAlias:
            """Represent a PEP 585 generic type

            For example, for t = list[int], t.__origin__ is list and t.__args__
            is (int,).
            """

else:
    class DictProxy[in out Key, in out Value](BaseProxy, MutableMapping[Key, Value]):
        __builtins__: ClassVar[dict[str, dynamic]]
        override def __len__(self) -> int
        override def __getitem__(self, key: Key, /) -> Value
        override def __setitem__(self, key: Key, value: Value, /)
        override def __delitem__(self, key: Key, /)
        override def __iter__(self) -> Iterator[Key]
        def copy(self) -> dict[Key, Value]

        override def get(self, key: Key, /) -> Value | None
        def get(self, key: Key, default: Value, /) -> Value
        def get[Element](self, key: Key, default: Element, /) -> Value | Element

        override def pop(self, key: Key, /) -> Value
        def pop(self, key: Key, default: Value, /) -> Value
        def pop[Element](self, key: Key, default: Element, /) -> Value | Element

        override def keys(self) -> list[Key]
        override def items(self) -> list[(Key, Value)]
        override def values(self) -> list[Value]

if sys.version_info >= (3, 14):
    class _BaseSetProxy[in out Element](BaseProxy, MutableSet[Element]):
        __builtins__: ClassVar[dict[str, dynamic]]
        # Copied from builtins.set
        def add(self, element: Element, /)
        def copy(self) -> set[Element]
        def clear(self)
        def difference(self, *s: Iterable[dynamic]) -> set[Element]
        def difference_update(self, *s: Iterable[dynamic])
        def discard(self, element: Element, /)
        def intersection(self, *s: Iterable[dynamic]) -> set[Element]
        def intersection_update(self, *s: Iterable[dynamic])
        def isdisjoint(self, s: Iterable[dynamic], /) -> bool
        def issubset(self, s: Iterable[dynamic], /) -> bool
        def issuperset(self, s: Iterable[dynamic], /) -> bool
        def pop(self) -> Element
        def remove(self, element: Element, /)
        def symmetric_difference(self, s: Iterable[Element], /) -> set[Element]
        def symmetric_difference_update(self, s: Iterable[Element], /)
        def union[Other](self, *s: Iterable[Other]) -> set[Element | Other]
        def update(self, *s: Iterable[Element])
        def __len__(self) -> int
        def __contains__(self, o: object, /) -> bool
        def __iter__(self) -> Iterator[Element]
        def __and__(self, value: AbstractSet[object], /) -> set[Element]
        def __iand__(self, value: AbstractSet[object], /) -> Self
        def __or__[Other](self, value: AbstractSet[Other], /) -> set[Element | Other]
        def __ior__(self, value: AbstractSet[Element], /) -> Self
        def __sub__(self, value: AbstractSet[Element | None], /) -> set[Element]
        def __isub__(self, value: AbstractSet[object], /) -> Self
        def __xor__[Other](self, value: AbstractSet[Other], /) -> set[Element | Other]
        def __ixor__(self, value: AbstractSet[Element], /) -> Self
        def __le__(self, value: AbstractSet[object], /) -> bool
        def __lt__(self, value: AbstractSet[object], /) -> bool
        def __ge__(self, value: AbstractSet[object], /) -> bool
        def __gt__(self, value: AbstractSet[object], /) -> bool
        def __eq__(self, value: object, /) -> bool
        def __rand__(self, value: AbstractSet[object], /) -> set[Element]
        def __ror__[Other](self, value: AbstractSet[Other], /) -> set[Element | Other]
        def __rsub__(self, value: AbstractSet[Element], /) -> set[Element]
        def __rxor__[Other](self, value: AbstractSet[Other], /) -> set[Element | Other]
        def __class_getitem__(cls, item: dynamic, /) -> GenericAlias

    class SetProxy[in out Element](_BaseSetProxy[Element])

class BaseListProxy[in out Element](BaseProxy, MutableSequence[Element]):
    __builtins__: ClassVar[dict[str, dynamic]]
    override def __len__(self) -> int
    def __add__(self, x: list[Element], /) -> list[Element]
    override def __delitem__(self, i: SupportsIndex | slice[SupportsIndex | None], /)

    override def __getitem__(self, i: SupportsIndex, /) -> Element
    def __getitem__(self, s: slice[SupportsIndex | None], /) -> list[Element]

    override def __setitem__(self, i: SupportsIndex, o: Element, /) -> None
    def __setitem__(self, s: slice[SupportsIndex | None], o: Iterable[Element], /) -> None

    def __mul__(self, n: SupportsIndex, /) -> list[Element]
    def __rmul__(self, n: SupportsIndex, /) -> list[Element]
    def __imul__(self, value: SupportsIndex, /) -> Self
    override def __reversed__(self) -> Iterator[Element]
    override def append(self, object: Element, /)
    override def extend(self, iterable: Iterable[Element], /)
    override def pop(self, index: SupportsIndex = ..., /) -> Element
    override def index(self, value: Element, start: SupportsIndex = ..., stop: SupportsIndex = ..., /) -> int
    override def count(self, value: Element, /) -> int
    override def insert(self, index: SupportsIndex, object: Element, /)
    override def remove(self, value: Element, /)
    if sys.version_info >= (3, 14):
        # Next methods are copied from builtins.list
        def clear(self)
        def copy(self) -> list[Element]

    # Use BaseListProxy[SupportsRichComparisonT] for the first overload rather than [SupportsRichComparison]
    # to work around invariance
    def sort(self: BaseListProxy[SupportsRichComparisonT], *, key: None = None, reverse: bool = ...) -> None
    def sort(self, *, key: (Element) -> SupportsRichComparison, reverse: bool = ...) -> None

class ListProxy[in out Element](BaseListProxy[Element]):
    override def __iadd__(self, value: Iterable[Element], /) -> Self
    override def __imul__(self, value: SupportsIndex, /) -> Self
    if sys.version_info >= (3, 13):
        def __class_getitem__(cls, args: dynamic, /) -> dynamic:
            """Represent a PEP 585 generic type

            For example, for t = list[int], t.__origin__ is list and t.__args__
            is (int,).
            """

# Send is (kind, result)
# Receive is (id, methodname, args, kwds)
private type ServerConnection = Connection[(str, dynamic), (str, str, Iterable[dynamic], Mapping[str, dynamic])]

# Returned by BaseManager.get_server()
class Server:
    """
    Server class which runs in a process controlled by a manager object
    """

    address: _Address | None
    id_to_obj: dict[str, (dynamic, set[str], dict[str, str])]
    fallback_mapping: dict[str, (ServerConnection, str, dynamic) -> dynamic]
    public: list[str]
    # Registry values are (callable, exposed, method_to_typeid, proxytype)
    init(
        self,
        registry: dict[str, ((...) -> dynamic, Iterable[str], dict[str, str], dynamic)],
        address: _Address | None,
        authkey: bytes,
        serializer: str,
    )
    def serve_forever(self):
        """
        Run the server forever
        """

    def accepter(self)
    def handle_request(self, conn: ServerConnection):
        """
        Handle a new connection
        """

    def serve_client(self, conn: ServerConnection):
        """
        Handle requests from the proxies in a particular process/thread
        """

    def fallback_getvalue[Element](self, conn: ServerConnection, ident: str, obj: Element) -> Element
    def fallback_str(self, conn: ServerConnection, ident: str, obj: dynamic) -> str
    def fallback_repr(self, conn: ServerConnection, ident: str, obj: dynamic) -> str
    def dummy(self, c: ServerConnection)
    def debug_info(self, c: ServerConnection) -> str:
        """
        Return some info --- useful to spot problems with refcounting
        """

    def number_of_objects(self, c: ServerConnection) -> int:
        """
        Number of shared objects
        """

    def shutdown(self, c: ServerConnection):
        """
        Shutdown this process
        """

    def create(self, c: ServerConnection, typeid: str, /, *args: dynamic, **kwds: dynamic) -> (str, (*: str)):
        """
        Create a new shared object and return its id
        """

    def get_methods(self, c: ServerConnection, token: Token) -> set[str]:
        """
        Return the methods of the shared object indicated by token
        """

    def accept_connection(self, c: ServerConnection, name: str):
        """
        Spawn a new thread to serve this connection
        """

    def incref(self, c: ServerConnection, ident: str)
    def decref(self, c: ServerConnection, ident: str)

class BaseManager:
    """
    Base class for managers
    """

    if sys.version_info >= (3, 11):
        def __init__(
            self,
            address: _Address | None = None,
            authkey: bytes | None = None,
            serializer: str = "pickle",
            ctx: BaseContext | None = None,
            *,
            shutdown_timeout: int | float = 1.0,
        ) -> None
    else:
        def __init__(
            self,
            address: _Address | None = None,
            authkey: bytes | None = None,
            serializer: str = "pickle",
            ctx: BaseContext | None = None,
        ) -> None

    def get_server(self) -> Server:
        """
        Return server object with serve_forever() method and address attribute
        """

    def connect(self):
        """
        Connect manager object to the server process
        """

    def start(self, initializer: (...) -> object | None = None, initargs: Iterable[dynamic] = ()):
        """
        Spawn a server process for this manager object
        """

    shutdown: _Finalize  # only available after start() was called
    def join(self, timeout: int | float | None = None):  # undocumented
        """
        Join the manager process (if it has been spawned)
        """

    let address: _Address | None
    class def register(
        cls,
        typeid: str,
        callable: (...) -> object | None = None,
        proxytype: dynamic = None,
        exposed: Sequence[str] | None = None,
        method_to_typeid: Mapping[str, str] | None = None,
        create_method: bool = True,
    ):
        """
        Register a typeid with the manager type
        """

    def __enter__(self) -> Self
    def __exit__(
        self, exc_type: type[BaseException] | None, exc_val: BaseException | None, exc_tb: TracebackType | None
    )

class SyncManager(BaseManager):
    """
    Subclass of `BaseManager` which supports a number of shared object types.

    The types registered are those intended for the synchronization
    of threads, plus `dict`, `list` and `Namespace`.

    The `multiprocessing.Manager()` function creates started instances of
    this class.
    """

    def Barrier(
        self, parties: int, action: (() -> None) | None = None, timeout: int | float | None = None
    ) -> threading.Barrier
    def BoundedSemaphore(self, value: int = 1) -> threading.BoundedSemaphore
    def Condition(self, lock: threading.Lock | threading._RLock | None = None) -> threading.Condition
    def Event(self) -> threading.Event
    def Lock(self) -> threading.Lock
    def Namespace(self) -> _Namespace
    def Pool(
        self,
        processes: int | None = None,
        initializer: (...) -> object | None = None,
        initargs: Iterable[dynamic] = (),
        maxtasksperchild: int | None = None,
        context: dynamic | None = None,
    ) -> pool.Pool
    def Queue(self, maxsize: int = ...) -> queue.Queue[dynamic]
    def JoinableQueue(self, maxsize: int = ...) -> queue.Queue[dynamic]
    def RLock(self) -> threading.RLock
    def Semaphore(self, value: int = 1) -> threading.Semaphore
    def Array[Element](self, typecode: dynamic, sequence: Sequence[Element]) -> Sequence[Element]
    def Value[Element](self, typecode: dynamic, value: Element) -> ValueProxy[Element]

    # Overloads are copied from builtins.dict.__init__
    def dict(self) -> DictProxy[dynamic, dynamic]
    def dict[Value](self, **kwargs: Value) -> DictProxy[str, Value]
    def dict[Key, Value](self, map: SupportsKeysAndGetItem[Key, Value], /) -> DictProxy[Key, Value]
    def dict[Value](self, map: SupportsKeysAndGetItem[str, Value], /, **kwargs: Value) -> DictProxy[str, Value]
    def dict[Key, Value](self, iterable: Iterable[(Key, Value)], /) -> DictProxy[Key, Value]
    def dict[Value](self, iterable: Iterable[(str, Value)], /, **kwargs: Value) -> DictProxy[str, Value]
    def dict(self, iterable: Iterable[builtins.list[str]], /) -> DictProxy[str, str]
    def dict(self, iterable: Iterable[builtins.list[bytes]], /) -> DictProxy[bytes, bytes]

    # Overloads are copied from builtins.list.__init__
    def list[Element](self, iterable: Iterable[Element], /) -> ListProxy[Element]
    def list(self) -> ListProxy[dynamic]

    if sys.version_info >= (3, 14):
        def set[Element](self, iterable: Iterable[Element], /) -> SetProxy[Element]
        def set(self) -> SetProxy[dynamic]

class RemoteError(Exception)

class SharedMemoryServer(Server):
    def track_segment(self, c: ServerConnection, segment_name: str):
        """Adds the supplied shared memory block name to Server's tracker."""

    def release_segment(self, c: ServerConnection, segment_name: str):
        """Calls unlink() on the shared memory block with the supplied name
        and removes it from the tracker instance inside the Server.
        """

    def list_segments(self, c: ServerConnection) -> list[str]:
        """Returns a list of names of shared memory blocks that the Server
        is currently tracking.
        """

class SharedMemoryManager(BaseManager):
    """Like SyncManager but uses SharedMemoryServer instead of Server.

    It provides methods for creating and returning SharedMemory instances
    and for creating a list-like object (ShareableList) backed by shared
    memory.  It also provides methods that create and return Proxy Objects
    that support synchronization across processes (i.e. multi-process-safe
    locks and semaphores).
    """

    override def get_server(self) -> SharedMemoryServer:
        """Better than monkeypatching for now; merge into Server ultimately"""

    def SharedMemory(self, size: int) -> _SharedMemory:
        """Returns a new SharedMemory instance with the specified size in
        bytes, to be tracked by the manager.
        """

    def ShareableList(self, sequence: Iterable[_SLT] | None) -> _ShareableList[_SLT]:
        """Returns a new ShareableList instance populated with the values
        from the input sequence, to be tracked by the manager.
        """

    def __del__(self)
