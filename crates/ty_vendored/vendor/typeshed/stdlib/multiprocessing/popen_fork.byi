import sys
from typing import ClassVar

from .process import BaseProcess
from .util import Finalize

if sys.platform != "win32":
    __all__ = ["Popen"]

    class Popen:
        finalizer: Finalize?
        method: ClassVar[str]
        pid: int
        returncode: int?
        sentinel: int  # doesn't exist if os.fork in _launch returns 0

        init(self, process_obj: BaseProcess)
        def duplicate_for_child(self, fd: int) -> int
        def poll(self, flag: int = 1) -> int?
        def wait(self, timeout: int | float | None = None) -> int?
        if sys.version_info >= (3, 14):
            def interrupt(self)

        def terminate(self)
        def kill(self)
        def close(self)
