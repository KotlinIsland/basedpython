import sys
from collections.abc import Iterable, Mapping

__all__ = ["BaseProcess", "current_process", "active_children", "parent_process"]

class BaseProcess:
    """
    Process objects represent activity that is run in a separate process

    The class is analogous to `threading.Thread`
    """

    name: str
    daemon: bool
    """
    Return whether process is a daemon
    """

    authkey: bytes
    _identity: (*: int)  # undocumented
    init(
        self,
        group: None = None,
        target: (...) -> object? = None,
        name: str? = None,
        args: Iterable[dynamic] = (),
        kwargs: Mapping[str, dynamic] = {},
        *,
        daemon: bool? = None,
    )
    def run(self):
        """
        Method to be run in sub-process; can be overridden in sub-class
        """

    def start(self):
        """
        Start child process
        """

    if sys.version_info >= (3, 14):
        def interrupt(self):
            """
            Terminate process; sends SIGINT signal
            """

    def terminate(self):
        """
        Terminate process; sends SIGTERM signal or uses TerminateProcess()
        """

    def kill(self):
        """
        Terminate process; sends SIGKILL signal or uses TerminateProcess()
        """

    def close(self):
        """
        Close the Process object.

        This method releases resources held by the Process object.  It is
        an error to call this method if the child process is still running.
        """

    def join(self, timeout: int | float | None = None):
        """
        Wait until child process terminates
        """

    def is_alive(self) -> bool:
        """
        Return whether process is alive
        """

    let exitcode: int?

    let ident: int?

    let pid: int?

    let sentinel: int

def current_process() -> BaseProcess:
    """
    Return process object representing the current process
    """

def active_children() -> list[BaseProcess]:
    """
    Return list of process objects corresponding to live child processes
    """

def parent_process() -> BaseProcess?:
    """
    Return process object representing the parent process
    """
