import sys
from multiprocessing.process import BaseProcess
from typing import ClassVar, Final

from .util import Finalize

if sys.platform == "win32":
    __all__ = ["Popen"]

    final TERMINATE: int
    final WINEXE: bool
    final WINSERVICE: bool
    final WINENV: bool

    class Popen:
        """
        Start a subprocess to run the code of a process object
        """

        finalizer: Finalize
        method: ClassVar[str]
        pid: int
        returncode: int | None
        sentinel: int

        init(self, process_obj: BaseProcess)
        def duplicate_for_child(self, handle: int) -> int
        def wait(self, timeout: int | float | None = None) -> int | None
        def poll(self) -> int | None
        def terminate(self)

        kill = terminate

        def close(self)
