import sys
from types import GenericAlias
from typing import Generic, NewType, TypeVar

__all__ = ["Queue", "SimpleQueue", "JoinableQueue"]


_QueueState = NewType("_QueueState", object)
_JoinableQueueState = NewType("_JoinableQueueState", object)
_SimpleQueueState = NewType("_SimpleQueueState", object)

class Queue[in out Element]:
    # FIXME: `ctx` is a circular dependency and it's not actually optional.
    # It's marked as such to be able to use the generic Queue in __init__.pyi.
    init(self, maxsize: int = 0, *, ctx: dynamic = ...)
    def __getstate__(self) -> _QueueState
    def __setstate__(self, state: _QueueState)
    def put(self, obj: Element, block: bool = True, timeout: float | None = None)
    def get(self, block: bool = True, timeout: float | None = None) -> Element
    def qsize(self) -> int
    def empty(self) -> bool
    def full(self) -> bool
    def get_nowait(self) -> Element
    def put_nowait(self, obj: Element)
    def close(self)
    def join_thread(self)
    def cancel_join_thread(self)
    if sys.version_info >= (3, 12):
        def __class_getitem__(cls, item: dynamic, /) -> GenericAlias:
            """Represent a PEP 585 generic type

            For example, for t = list[int], t.__origin__ is list and t.__args__
            is (int,).
            """

class JoinableQueue[in out Element](Queue[Element]):
    override def __getstate__(self) -> _JoinableQueueState
    override def __setstate__(self, state: _JoinableQueueState) -> None
    def task_done(self)
    def join(self)

class SimpleQueue[in out Element]:
    init(self, *, ctx: dynamic = ...)
    def close(self)
    def empty(self) -> bool
    def __getstate__(self) -> _SimpleQueueState
    def __setstate__(self, state: _SimpleQueueState)
    def get(self) -> Element
    def put(self, obj: Element)
    def __class_getitem__(cls, item: dynamic, /) -> GenericAlias:
        """Represent a PEP 585 generic type

        For example, for t = list[int], t.__origin__ is list and t.__args__
        is (int,).
        """
