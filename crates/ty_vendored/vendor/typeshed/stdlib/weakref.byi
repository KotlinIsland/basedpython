"""Weak reference support for Python.

This module is an implementation of PEP 205:

https://peps.python.org/pep-0205/
"""

from _typeshed import SupportsKeysAndGetItem
from _weakref export getweakrefcount, getweakrefs, proxy
from _weakrefset export WeakSet
from collections.abc import Callable, Iterable, Iterator, Mapping, MutableMapping
from types import GenericAlias
from typing import ClassVar, Generic, ParamSpec, TypeVar, final
from typing_extensions import Self, disjoint_base

__all__ = [
    "ref",
    "proxy",
    "getweakrefcount",
    "getweakrefs",
    "WeakKeyDictionary",
    "ReferenceType",
    "ProxyType",
    "CallableProxyType",
    "ProxyTypes",
    "WeakValueDictionary",
    "WeakSet",
    "WeakMethod",
    "finalize",
]


ProxyTypes: (*: type[dynamic])

# These classes are implemented in C and imported from _weakref at runtime. However,
# they consider themselves to live in the weakref module for sys.version_info >= (3, 11),
# so defining their stubs here means we match their __module__ value.
# Prior to 3.11 they did not declare a module for themselves and ended up looking like they
# came from the builtin module at runtime, which was just wrong, and we won't attempt to
# duplicate that.

final class CallableProxyType[in out CallableT: (...) -> dynamic]:  # "weakcallableproxy"
    override def __eq__(self, value: object, /) -> bool
    def __getattr__(self, attr: str) -> dynamic
    __call__: CallableT
    """Call self as a function."""

    __hash__: ClassVar[None]

final class ProxyType[in out Element]:  # "weakproxy"
    override def __eq__(self, value: object, /) -> bool
    def __getattr__(self, attr: str) -> dynamic
    __hash__: ClassVar[None]

@disjoint_base
class ReferenceType[in out Element]:  # "weakref"
    __callback__: (Self) -> dynamic
    def __new__(cls, o: Element, callback: ((Self) -> dynamic) | None = ..., /) -> Self
    def __call__(self) -> Element | None:
        """Call self as a function."""

    override def __eq__(self, value: object, /) -> bool
    override def __hash__(self) -> int
    def __class_getitem__(cls, item: dynamic, /) -> GenericAlias:
        """Weakrefs are generic over the type of the referenced object."""

ref = ReferenceType

# everything below here is implemented in weakref.py

class WeakMethod[in out CallableT: (...) -> dynamic](ref[CallableT]):
    """
    A custom `weakref.ref` subclass which simulates a weak reference to
    a bound method, working around the lifetime problem of bound methods.
    """

    __slots__ = ("_func_ref", "_meth_type", "_alive", "__weakref__")
    def __new__(cls, meth: CallableT, callback: ((Self) -> dynamic) | None = None) -> Self
    override def __call__(self) -> CallableT | None
    override def __eq__(self, other: object) -> bool
    override def __ne__(self, other: object) -> bool
    override def __hash__(self) -> int

class WeakValueDictionary[in out Key, in out Value](MutableMapping[Key, Value]):
    """Mapping class that references values weakly.

    Entries in the dictionary will be discarded when no strong
    reference to the value exists anymore
    """

    init(self)
    init(
        self: WeakValueDictionary[Key, Value],
        other: Mapping[Key, Value] | Iterable[(Key, Value)],
        /,
    )
    init(
        self: WeakValueDictionary[str, Value],
        other: Mapping[str, Value] | Iterable[(str, Value)] = (),
        /,
        **kwargs: Value,
    )

    override def __len__(self) -> int
    override def __getitem__(self, key: Key) -> Value
    override def __setitem__(self, key: Key, value: Value)
    override def __delitem__(self, key: Key)
    override def __contains__(self, key: object) -> bool
    override def __iter__(self) -> Iterator[Key]
    def copy(self) -> WeakValueDictionary[Key, Value]
    __copy__ = copy
    def __deepcopy__(self, memo: dynamic) -> Self

    override def get(self, key: Key, default: None = None) -> Value | None
    def get(self, key: Key, default: Value) -> Value
    def get[Element](self, key: Key, default: Element) -> Value | Element

    # These are incompatible with Mapping
    override def keys(self) -> Iterator[Key]
    override def values(self) -> Iterator[Value]
    override def items(self) -> Iterator[(Key, Value)]
    def itervaluerefs(self) -> Iterator[KeyedRef[Key, Value]]:
        """Return an iterator that yields the weak references to the values.

        The references are not guaranteed to be 'live' at the time
        they are used, so the result of calling the references needs
        to be checked before being used.  This can be used to avoid
        creating references that will cause the garbage collector to
        keep the values around longer than needed.

        """

    def valuerefs(self) -> list[KeyedRef[Key, Value]]:
        """Return a list of weak references to the values.

        The references are not guaranteed to be 'live' at the time
        they are used, so the result of calling the references needs
        to be checked before being used.  This can be used to avoid
        creating references that will cause the garbage collector to
        keep the values around longer than needed.

        """

    override def setdefault(self, key: Key, default: Value) -> Value

    override def pop(self, key: Key) -> Value
    def pop(self, key: Key, default: Value) -> Value
    def pop[Element](self, key: Key, default: Element) -> Value | Element

    override def update(self, other: SupportsKeysAndGetItem[Key, Value], /, **kwargs: Value) -> None
    def update(self, other: Iterable[(Key, Value)], /, **kwargs: Value) -> None
    def update(self, other: None = None, /, **kwargs: Value) -> None

    def __or__[T1, T2](self, other: Mapping[T1, T2]) -> WeakValueDictionary[Key | T1, Value | T2]
    def __ror__[T1, T2](self, other: Mapping[T1, T2]) -> WeakValueDictionary[Key | T1, Value | T2]

    # WeakValueDictionary.__ior__ should be kept roughly in line with MutableMapping.update()
    def __ior__(self, other: SupportsKeysAndGetItem[Key, Value]) -> Self
    def __ior__(self, other: Iterable[(Key, Value)]) -> Self

class KeyedRef[in out Key, in out Element](ref[Element]):
    """Specialized reference that includes a key corresponding to the value.

    This is used in the WeakValueDictionary to avoid having to create
    a function object for each key stored in the mapping.  A shared
    callback object can use the 'key' attribute of a KeyedRef instead
    of getting a reference to the key from an enclosing scope.

    """

    __slots__ = ("key",)
    key: Key
    def __new__(type, ob: Element, callback: (Self) -> dynamic, key: Key) -> Self
    init(self, ob: Element, callback: (Self) -> dynamic, key: Key)

class WeakKeyDictionary[in out Key, in out Value](MutableMapping[Key, Value]):
    """Mapping class that references keys weakly.

    Entries in the dictionary will be discarded when there is no
    longer a strong reference to the key. This can be used to
    associate additional data with an object owned by other parts of
    an application without adding attributes to those objects. This
    can be especially useful with objects that override attribute
    accesses.
    """

    init(self, dict: None = None)
    init(self, dict: Mapping[Key, Value] | Iterable[(Key, Value)])

    override def __len__(self) -> int
    override def __getitem__(self, key: Key) -> Value
    override def __setitem__(self, key: Key, value: Value)
    override def __delitem__(self, key: Key)
    override def __contains__(self, key: object) -> bool
    override def __iter__(self) -> Iterator[Key]
    def copy(self) -> WeakKeyDictionary[Key, Value]
    __copy__ = copy
    def __deepcopy__(self, memo: dynamic) -> Self

    override def get(self, key: Key, default: None = None) -> Value | None
    def get(self, key: Key, default: Value) -> Value
    def get[Element](self, key: Key, default: Element) -> Value | Element

    # These are incompatible with Mapping
    override def keys(self) -> Iterator[Key]
    override def values(self) -> Iterator[Value]
    override def items(self) -> Iterator[(Key, Value)]
    def keyrefs(self) -> list[ref[Key]]:
        """Return a list of weak references to the keys.

        The references are not guaranteed to be 'live' at the time
        they are used, so the result of calling the references needs
        to be checked before being used.  This can be used to avoid
        creating references that will cause the garbage collector to
        keep the keys around longer than needed.

        """

    # Keep WeakKeyDictionary.setdefault in line with MutableMapping.setdefault, modulo positional-only differences
    override def setdefault(self: WeakKeyDictionary[Key, Value | None], key: Key, default: None = None) -> Value
    def setdefault(self, key: Key, default: Value) -> Value

    override def pop(self, key: Key) -> Value
    def pop(self, key: Key, default: Value) -> Value
    def pop[Element](self, key: Key, default: Element) -> Value | Element

    override def update(self, dict: SupportsKeysAndGetItem[Key, Value], /, **kwargs: Value) -> None
    def update(self, dict: Iterable[(Key, Value)], /, **kwargs: Value) -> None
    def update(self, dict: None = None, /, **kwargs: Value) -> None

    def __or__[T1, T2](self, other: Mapping[T1, T2]) -> WeakKeyDictionary[Key | T1, Value | T2]
    def __ror__[T1, T2](self, other: Mapping[T1, T2]) -> WeakKeyDictionary[Key | T1, Value | T2]

    # WeakKeyDictionary.__ior__ should be kept roughly in line with MutableMapping.update()
    def __ior__(self, other: SupportsKeysAndGetItem[Key, Value]) -> Self
    def __ior__(self, other: Iterable[(Key, Value)]) -> Self

class finalize[Parameters: (*: *, **: *), in out Element]:
    """Class for finalization of weakrefable objects

    finalize(obj, func, *args, **kwargs) returns a callable finalizer
    object which will be called when obj is garbage collected. The
    first time the finalizer is called it evaluates func(*arg, **kwargs)
    and returns the result. After this the finalizer is dead, and
    calling it just returns None.

    When the program exits any remaining finalizers for which the
    atexit attribute is true will be run in reverse order of creation.
    By default atexit is true.
    """

    __slots__ = ()
    init(self, obj: Element, func: (**Parameters) -> dynamic, /, *args: *Parameters, **kwargs: **Parameters)
    def __call__(self, _: dynamic = None) -> dynamic | None:
        """If alive then mark as dead and return func(*args, **kwargs);
        otherwise return None
        """

    def detach(self) -> (Element, (**Parameters) -> dynamic, (*: dynamic), dict[str, dynamic]) | None:
        """If alive then mark as dead and return (obj, func, args, kwargs);
        otherwise return None
        """

    def peek(self) -> (Element, (**Parameters) -> dynamic, (*: dynamic), dict[str, dynamic]) | None:
        """If alive then return (obj, func, args, kwargs);
        otherwise return None
        """

    let alive: bool

    atexit: bool
    """Whether finalizer should be called at exit"""
