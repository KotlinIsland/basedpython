"""Read/write support for Maildir, mbox, MH, Babyl, and MMDF mailboxes."""

import email.message
import io
import sys
from _typeshed import StrPath, SupportsItems, SupportsNoArgReadline, SupportsRead, SupportsWrite, Unused
from abc import ABCMeta
from collections.abc import Callable, Iterable, Iterator, Mapping, Sequence
from types import GenericAlias, TracebackType
from typing import Generic, Literal, Protocol, TypeAlias, TypeVar, type_check_only
from typing_extensions import Self

__all__ = [
    "Mailbox",
    "Maildir",
    "mbox",
    "MH",
    "Babyl",
    "MMDF",
    "Message",
    "MaildirMessage",
    "mboxMessage",
    "MHMessage",
    "BabylMessage",
    "MMDFMessage",
    "Error",
    "NoSuchMailboxError",
    "NotEmptyError",
    "ExternalClashError",
    "FormatError",
]


@type_check_only
private protocol SupportsReadAndReadline(SupportsRead[bytes], SupportsNoArgReadline[bytes])

# As opposed to _MessageT_co in email._policybase, this type is bound to
# mailbox.Message instead of email.message.Message.

private type MessageData = email.message.Message | bytes | str | io.StringIO | SupportsReadAndReadline

@type_check_only
private protocol HasIteritems:
    def iteritems(self) -> Iterator[(str, MessageData)]

linesep: bytes

# Common interface for get_file() return types.
@type_check_only
private protocol GetFileReturn:
    def __iter__(self) -> Iterator[bytes]
    def __enter__(self) -> Self
    def __exit__(
        self, exc_type: type[BaseException] | None, exc: BaseException | None, tb: TracebackType | None, /
    ) -> bool | None
    def read(self, size: int | None = None, /) -> bytes
    def read1(self, size: int | None = None, /) -> bytes
    def readline(self, size: int | None = None, /) -> bytes
    def readlines(self, sizehint: int | None = None, /) -> list[bytes]
    def tell(self) -> int
    def seek(self, offset: int, whence: int = 0, /) -> object
    def close(self) -> object
    def readable(self) -> bool
    def writable(self) -> bool
    def seekable(self) -> bool
    def flush(self) -> object
    let closed: bool

class Mailbox[out MessageT: Message = Message]:
    """A group of messages in a particular place."""

    _path: str  # undocumented
    _factory: ((GetFileReturn) -> MessageT) | None  # undocumented

    init(self, path: StrPath, factory: (GetFileReturn) -> MessageT, create: bool = True):
        """Initialize a Mailbox instance."""
    init(self, path: StrPath, factory: None = None, create: bool = True)

    abstract def add(self, message: MessageData) -> str:
        """Add message and return assigned key."""

    abstract def remove(self, key: str):
        """Remove the keyed message; raise KeyError if it doesn't exist."""

    def __delitem__(self, key: str)
    def discard(self, key: str):
        """If the keyed message exists, remove it."""

    abstract def __setitem__(self, key: str, message: MessageData):
        """Replace the keyed message; raise KeyError if it doesn't exist."""

    def get(self, key: str, default: None = None) -> MessageT | None:
        """Return the keyed message, or default if it doesn't exist."""
    def get[Element](self, key: str, default: Element) -> MessageT | Element

    def __getitem__(self, key: str) -> MessageT:
        """Return the keyed message; raise KeyError if it doesn't exist."""

    abstract def get_message(self, key: str) -> MessageT:
        """Return a Message representation or raise a KeyError."""

    def get_string(self, key: str) -> str:
        """Return a string representation or raise a KeyError.

        Uses email.message.Message to create a 7bit clean string
        representation of the message.
        """

    abstract def get_bytes(self, key: str) -> bytes:
        """Return a byte string representation or raise a KeyError."""

    abstract def get_file(self, key: str) -> GetFileReturn:
        """Return a file-like representation or raise a KeyError."""

    abstract def iterkeys(self) -> Iterator[str]:
        """Return an iterator over keys."""

    def keys(self) -> list[str]:
        """Return a list of keys."""

    def itervalues(self) -> Iterator[MessageT]:
        """Return an iterator over all messages."""

    def __iter__(self) -> Iterator[MessageT]
    def values(self) -> list[MessageT]:
        """Return a list of messages. Memory intensive."""

    def iteritems(self) -> Iterator[(str, MessageT)]:
        """Return an iterator over (key, message) tuples."""

    def items(self) -> list[(str, MessageT)]:
        """Return a list of (key, message) tuples. Memory intensive."""

    abstract def __contains__(self, key: str) -> bool:
        """Return True if the keyed message exists, False otherwise."""

    abstract def __len__(self) -> int:
        """Return a count of messages in the mailbox."""

    def clear(self):
        """Delete all messages."""

    def pop(self, key: str, default: None = None) -> MessageT | None:
        """Delete the keyed message and return it, or default."""
    def pop[Element](self, key: str, default: Element) -> MessageT | Element

    def popitem(self) -> (str, MessageT):
        """Delete an arbitrary (key, message) pair and return it."""

    def update(
        self, arg: HasIteritems | SupportsItems[str, MessageData] | Iterable[(str, MessageData)] | None = None
    ):
        """Change the messages that correspond to certain keys."""

    abstract def flush(self):
        """Write any pending changes to the disk."""

    abstract def lock(self):
        """Lock the mailbox."""

    abstract def unlock(self):
        """Unlock the mailbox if it is locked."""

    abstract def close(self):
        """Flush and close the mailbox."""

    # Undocumented, called by subclasses to parse added messages.
    def _dump_message(self, message: MessageData, target: SupportsWrite[bytes], mangle_from_: bool = False):
        """Dump message contents to target file."""

    def __class_getitem__(cls, item: dynamic, /) -> GenericAlias:
        """Represent a PEP 585 generic type

        For example, for t = list[int], t.__origin__ is list and t.__args__
        is (int,).
        """

class Maildir(Mailbox[MaildirMessage]):
    """A qmail-style Maildir mailbox."""

    colon: str
    init(
        self, dirname: StrPath, factory: ((GetFileReturn) -> MaildirMessage) | None = None, create: bool = True
    ):
        """Initialize a Maildir instance."""

    override def add(self, message: MessageData | MaildirMessage) -> str:
        """Add message and return assigned key."""

    override def remove(self, key: str):
        """Remove the keyed message; raise KeyError if it doesn't exist."""

    override def __setitem__(self, key: str, message: MessageData | MaildirMessage):
        """Replace the keyed message; raise KeyError if it doesn't exist."""

    override def get_message(self, key: str) -> MaildirMessage:
        """Return a Message representation or raise a KeyError."""

    override def get_bytes(self, key: str) -> bytes:
        """Return a bytes representation or raise a KeyError."""

    override def get_file(self, key: str) -> _ProxyFile:
        """Return a file-like representation or raise a KeyError."""

    if sys.version_info >= (3, 13):
        def get_info(self, key: str) -> str:
            """Get the keyed message's "info" as a string."""

        def set_info(self, key: str, info: str):
            """Set the keyed message's "info" string."""

        def get_flags(self, key: str) -> str:
            """Return as a string the standard flags that are set on the keyed message."""

        def set_flags(self, key: str, flags: str):
            """Set the given flags and unset all others on the keyed message."""

        def add_flag(self, key: str, flag: str):
            """Set the given flag(s) without changing others on the keyed message."""

        def remove_flag(self, key: str, flag: str):
            """Unset the given string flag(s) without changing others on the keyed message."""

    override def iterkeys(self) -> Iterator[str]:
        """Return an iterator over keys."""

    override def __contains__(self, key: str) -> bool:
        """Return True if the keyed message exists, False otherwise."""

    override def __len__(self) -> int:
        """Return a count of messages in the mailbox."""

    override def flush(self):
        """Write any pending changes to disk."""

    override def lock(self):
        """Lock the mailbox."""

    override def unlock(self):
        """Unlock the mailbox if it is locked."""

    override def close(self):
        """Flush and close the mailbox."""

    def list_folders(self) -> list[str]:
        """Return a list of folder names."""

    def get_folder(self, folder: str) -> Maildir:
        """Return a Maildir instance for the named folder."""

    def add_folder(self, folder: str) -> Maildir:
        """Create a folder and return a Maildir instance representing it."""

    def remove_folder(self, folder: str):
        """Delete the named folder, which must be empty."""

    def clean(self):
        """Delete old files in "tmp"."""

    def next(self) -> str | None:
        """Return the next message in a one-time iteration."""

class _singlefileMailbox[out MessageT: Message = Message](Mailbox[MessageT], metaclass=ABCMeta):
    """A single-file mailbox."""

    override def add(self, message: MessageData) -> str:
        """Add message and return assigned key."""

    override def remove(self, key: str):
        """Remove the keyed message; raise KeyError if it doesn't exist."""

    override def __setitem__(self, key: str, message: MessageData):
        """Replace the keyed message; raise KeyError if it doesn't exist."""

    override def iterkeys(self) -> Iterator[str]:
        """Return an iterator over keys."""

    override def __contains__(self, key: str) -> bool:
        """Return True if the keyed message exists, False otherwise."""

    override def __len__(self) -> int:
        """Return a count of messages in the mailbox."""

    override def lock(self):
        """Lock the mailbox."""

    override def unlock(self):
        """Unlock the mailbox if it is locked."""

    override def flush(self):
        """Write any pending changes to disk."""

    override def close(self):
        """Flush and close the mailbox."""

class _mboxMMDF[out MessageT: Message = Message](_singlefileMailbox[MessageT]):
    """An mbox or MMDF mailbox."""

    override def get_message(self, key: str) -> MessageT:
        """Return a Message representation or raise a KeyError."""

    override def get_file(self, key: str, from_: bool = False) -> _PartialFile:
        """Return a file-like representation or raise a KeyError."""

    override def get_bytes(self, key: str, from_: bool = False) -> bytes:
        """Return a string representation or raise a KeyError."""

    override def get_string(self, key: str, from_: bool = False) -> str:
        """Return a string representation or raise a KeyError."""

class mbox(_mboxMMDF[mboxMessage]):
    """A classic mbox mailbox."""

    init(
        self, path: StrPath, factory: ((GetFileReturn) -> mboxMessage) | None = None, create: bool = True
    ):
        """Initialize an mbox mailbox."""

class MMDF(_mboxMMDF[MMDFMessage]):
    """An MMDF mailbox."""

    init(
        self, path: StrPath, factory: ((GetFileReturn) -> MMDFMessage) | None = None, create: bool = True
    ):
        """Initialize an MMDF mailbox."""

class MH(Mailbox[MHMessage]):
    """An MH mailbox."""

    init(self, path: StrPath, factory: ((GetFileReturn) -> MHMessage) | None = None, create: bool = True):
        """Initialize an MH instance."""

    override def add(self, message: MessageData) -> str:
        """Add message and return assigned key."""

    override def remove(self, key: str):
        """Remove the keyed message; raise KeyError if it doesn't exist."""

    override def __setitem__(self, key: str, message: MessageData):
        """Replace the keyed message; raise KeyError if it doesn't exist."""

    override def get_message(self, key: str) -> MHMessage:
        """Return a Message representation or raise a KeyError."""

    override def get_bytes(self, key: str) -> bytes:
        """Return a bytes representation or raise a KeyError."""

    override def get_file(self, key: str) -> _ProxyFile:
        """Return a file-like representation or raise a KeyError."""

    override def iterkeys(self) -> Iterator[str]:
        """Return an iterator over keys."""

    override def __contains__(self, key: str) -> bool:
        """Return True if the keyed message exists, False otherwise."""

    override def __len__(self) -> int:
        """Return a count of messages in the mailbox."""

    override def flush(self):
        """Write any pending changes to the disk."""

    override def lock(self):
        """Lock the mailbox."""

    override def unlock(self):
        """Unlock the mailbox if it is locked."""

    override def close(self):
        """Flush and close the mailbox."""

    def list_folders(self) -> list[str]:
        """Return a list of folder names."""

    def get_folder(self, folder: StrPath) -> MH:
        """Return an MH instance for the named folder."""

    def add_folder(self, folder: StrPath) -> MH:
        """Create a folder and return an MH instance representing it."""

    def remove_folder(self, folder: StrPath):
        """Delete the named folder, which must be empty."""

    def get_sequences(self) -> dict[str, list[int]]:
        """Return a name-to-key-list dictionary to define each sequence."""

    def set_sequences(self, sequences: Mapping[str, Sequence[int]]):
        """Set sequences using the given name-to-key-list dictionary."""

    def pack(self):
        """Re-name messages to eliminate numbering gaps. Invalidates keys."""

class Babyl(_singlefileMailbox[BabylMessage]):
    """An Rmail-style Babyl mailbox."""

    init(
        self, path: StrPath, factory: ((GetFileReturn) -> BabylMessage) | None = None, create: bool = True
    ):
        """Initialize a Babyl mailbox."""

    override def get_message(self, key: str) -> BabylMessage:
        """Return a Message representation or raise a KeyError."""

    override def get_bytes(self, key: str) -> bytes:
        """Return a string representation or raise a KeyError."""

    override def get_file(self, key: str) -> io.BytesIO:
        """Return a file-like representation or raise a KeyError."""

    def get_labels(self) -> list[str]:
        """Return a list of user-defined labels in the mailbox."""

class Message(email.message.Message[str, str]):
    """Message with mailbox-format-specific properties."""

    init(self, message: MessageData | None = None):
        """Initialize a Message instance."""

class MaildirMessage(Message):
    """Message with Maildir-specific properties."""

    def get_subdir(self) -> str:
        """Return 'new' or 'cur'."""

    def set_subdir(self, subdir: "new" | "cur"):
        """Set subdir to 'new' or 'cur'."""

    def get_flags(self) -> str:
        """Return as a string the flags that are set."""

    def set_flags(self, flags: Iterable[str]):
        """Set the given flags and unset all others."""

    def add_flag(self, flag: str):
        """Set the given flag(s) without changing others."""

    def remove_flag(self, flag: str):
        """Unset the given string flag(s) without changing others."""

    def get_date(self) -> int:
        """Return delivery date of message, in seconds since the epoch."""

    def set_date(self, date: float):
        """Set delivery date of message, in seconds since the epoch."""

    def get_info(self) -> str:
        """Get the message's "info" as a string."""

    def set_info(self, info: str):
        """Set the message's "info" string."""

class _mboxMMDFMessage(Message):
    """Message with mbox- or MMDF-specific properties."""

    def get_from(self) -> str:
        """Return contents of "From " line."""

    def set_from(self, from_: str, time_: bool | (int, int, int, int, int, int, int, int, int) | None = None):
        """Set "From " line, formatting and appending time_ if specified."""

    def get_flags(self) -> str:
        """Return as a string the flags that are set."""

    def set_flags(self, flags: Iterable[str]):
        """Set the given flags and unset all others."""

    def add_flag(self, flag: str):
        """Set the given flag(s) without changing others."""

    def remove_flag(self, flag: str):
        """Unset the given string flag(s) without changing others."""

class mboxMessage(_mboxMMDFMessage):
    """Message with mbox-specific properties."""

class MHMessage(Message):
    """Message with MH-specific properties."""

    def get_sequences(self) -> list[str]:
        """Return a list of sequences that include the message."""

    def set_sequences(self, sequences: Iterable[str]):
        """Set the list of sequences that include the message."""

    def add_sequence(self, sequence: str):
        """Add sequence to list of sequences including the message."""

    def remove_sequence(self, sequence: str):
        """Remove sequence from the list of sequences including the message."""

class BabylMessage(Message):
    """Message with Babyl-specific properties."""

    def get_labels(self) -> list[str]:
        """Return a list of labels on the message."""

    def set_labels(self, labels: Iterable[str]):
        """Set the list of labels on the message."""

    def add_label(self, label: str):
        """Add label to list of labels on the message."""

    def remove_label(self, label: str):
        """Remove label from the list of labels on the message."""

    def get_visible(self) -> Message:
        """Return a Message representation of visible headers."""

    def set_visible(self, visible: MessageData):
        """Set the Message representation of visible headers."""

    def update_visible(self):
        """Update and/or sensibly generate a set of visible headers."""

class MMDFMessage(_mboxMMDFMessage):
    """Message with MMDF-specific properties."""

# Until Python 3.14, this class was technically - but unnecessarily - generic at runtime.
class _ProxyFile:
    """A read-only wrapper of a file."""

    init(self, f: GetFileReturn, pos: int | None = None):
        """Initialize a _ProxyFile."""

    def read(self, size: int | None = None) -> bytes:
        """Read bytes."""

    def read1(self, size: int | None = None) -> bytes:
        """Read bytes."""

    def readline(self, size: int | None = None) -> bytes:
        """Read a line."""

    def readlines(self, sizehint: int | None = None) -> list[bytes]:
        """Read multiple lines."""

    def __iter__(self) -> Iterator[bytes]:
        """Iterate over lines."""

    def tell(self) -> int:
        """Return the position."""

    def seek(self, offset: int, whence: int = 0):
        """Change position."""

    def close(self):
        """Close the file."""

    def __enter__(self) -> Self:
        """Context management protocol support."""

    def __exit__(self, *exc: Unused)
    def readable(self) -> bool
    def writable(self) -> bool
    def seekable(self) -> bool
    def flush(self)
    let closed: bool
    def __class_getitem__(cls, item: dynamic, /) -> GenericAlias:
        """Represent a PEP 585 generic type

        E.g. for t = list[int], t.__origin__ is list and t.__args__ is (int,).
        """

class _PartialFile(_ProxyFile):
    """A read-only wrapper of part of a file."""

    init(self, f: GetFileReturn, start: int | None = None, stop: int | None = None):
        """Initialize a _PartialFile."""

class Error(Exception):
    """Raised for module-specific errors."""

class NoSuchMailboxError(Error):
    """The specified mailbox does not exist and won't be created."""

class NotEmptyError(Error):
    """The specified mailbox is not empty and deletion was requested."""

class ExternalClashError(Error):
    """Another process caused an action to fail."""

class FormatError(Error):
    """A file appears to have an invalid format."""
