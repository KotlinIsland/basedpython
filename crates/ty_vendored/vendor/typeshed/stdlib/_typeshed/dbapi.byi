# PEP 249 Database API 2.0 Types
# https://www.python.org/dev/peps/pep-0249/

from collections.abc import Mapping, Sequence
from typing import Protocol, TypeAlias

type DBAPITypeCode = dynamic?
# Strictly speaking, this should be a Sequence, but the type system does
# not support fixed-length sequences.
type DBAPIColumnDescription = (str, DBAPITypeCode, int?, int?, int?, int?, bool?)

protocol DBAPIConnection:
    def close(self) -> object
    def commit(self) -> object
    # optional:
    # def rollback(self) -> Any: ...
    def cursor(self) -> DBAPICursor

protocol DBAPICursor:
    let description: Sequence[DBAPIColumnDescription]?
    let rowcount: int
    # optional:
    # def callproc(self, procname: str, parameters: Sequence[Any] = ..., /) -> Sequence[Any]: ...
    def close(self) -> object
    def execute(self, operation: str, parameters: Sequence[dynamic] | Mapping[str, dynamic] = ..., /) -> object
    def executemany(self, operation: str, seq_of_parameters: Sequence[Sequence[dynamic]], /) -> object
    def fetchone(self) -> Sequence[dynamic]?
    def fetchmany(self, size: int = ..., /) -> Sequence[Sequence[dynamic]]
    def fetchall(self) -> Sequence[Sequence[dynamic]]
    # optional:
    # def nextset(self) -> None | Literal[True]: ...
    arraysize: int
    def setinputsizes(self, sizes: Sequence[DBAPITypeCode | int | None], /) -> object
    def setoutputsize(self, size: int, column: int = ..., /) -> object
