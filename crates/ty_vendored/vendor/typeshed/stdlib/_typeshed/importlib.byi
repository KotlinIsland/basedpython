# Implicit protocols used in importlib.
# We intentionally omit deprecated and optional methods.

from collections.abc import Sequence
from importlib.machinery import ModuleSpec
from types import ModuleType
from typing import Protocol

__all__ = ["LoaderProtocol", "MetaPathFinderProtocol", "PathEntryFinderProtocol"]

protocol LoaderProtocol:
    def load_module(self, fullname: str, /) -> ModuleType

protocol MetaPathFinderProtocol:
    def find_spec(self, fullname: str, path: Sequence[str]?, target: ModuleType? = ..., /) -> ModuleSpec?

protocol PathEntryFinderProtocol:
    def find_spec(self, fullname: str, target: ModuleType? = ..., /) -> ModuleSpec?
