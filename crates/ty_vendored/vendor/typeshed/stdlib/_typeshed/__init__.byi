# Utility types for typeshed
#
# See the README.md file in this directory for more information.

import sys
from collections.abc import Awaitable, Callable, Iterable, Iterator, Sequence, Set as AbstractSet, Sized
from dataclasses import Field
from os import PathLike
from types import FrameType, NoneType as NoneType, TracebackType
from typing import ClassVar, Final, Generic, Literal, Protocol, TypeAlias, TypeVar
from typing_extensions import Buffer, LiteralString, Self as _Self


# Alternative to `typing_extensions.Self`, exclusively for use with `__new__`
# in metaclasses:
#     def __new__(cls: type[Self], ...) -> Self: ...
# In other cases, use `typing_extensions.Self`.
Self = TypeVar("Self")  # noqa: Y001

# covariant version of typing.AnyStr, useful for protocols
AnyStr_co = TypeVar("AnyStr_co", str, bytes, covariant=True)  # noqa: Y001

# For partially known annotations. Usually, fields where type annotations
# haven't been added are left unannotated, but in some situations this
# isn't possible or a type is already partially known. In cases like these,
# use Incomplete instead of Any as a marker. For example, use
# "Incomplete | None" instead of "Any | None".
type Incomplete = dynamic  # stable

# To describe a function parameter that is unused and will work with anything.
type Unused = object  # stable

# Marker for return types that include None, but where forcing the user to
# check for None can be detrimental. Sometimes called "the Any trick". See
# https://typing.python.org/en/latest/guides/writing_stubs.html#the-any-trick
# for more information.
type MaybeNone = dynamic  # stable

# typeshed-internal type aliases to facilitate transition from
# `float` to either `float | int` or `float` (and similar for `complex`).
# When you encounter one of these type aliases, you are encouraged to
# replace them with the correct type. Please don't use them outside typeshed.
# See https://github.com/python/typeshed/issues/16059 for details.
type FloatInt = float | int
type ComplexInt = complex | float | int

# Used to mark arguments that default to a sentinel value. This prevents
# stubtest from complaining about the default value not matching.
#
# def foo(x: int | None = sentinel) -> None: ...
#
# In cases where the sentinel object is exported and can be used by user code,
# a construct like this is better:
#
# _SentinelType = NewType("_SentinelType", object)  # does not exist at runtime
# sentinel: Final[_SentinelType]
# def foo(x: int | None | _SentinelType = ...) -> None: ...
sentinel: dynamic  # stable

# stable
protocol IdentityFunction:
    def __call__[Element](self, x: Element, /) -> Element

# stable
protocol SupportsNext[out Element]:
    def __next__(self) -> Element

# stable
protocol SupportsAnext[out Element]:
    def __anext__(self) -> Awaitable[Element]

protocol SupportsBool:
    def __bool__(self) -> bool

# Comparison protocols
protocol SupportsDunderLT[in Input]:
    def __lt__(self, other: Input, /) -> SupportsBool

protocol SupportsDunderGT[in Input]:
    def __gt__(self, other: Input, /) -> SupportsBool

protocol SupportsDunderLE[in Input]:
    def __le__(self, other: Input, /) -> SupportsBool

protocol SupportsDunderGE[in Input]:
    def __ge__(self, other: Input, /) -> SupportsBool

protocol SupportsAllComparisons(SupportsDunderLT[dynamic], SupportsDunderGT[dynamic], SupportsDunderLE[dynamic], SupportsDunderGE[dynamic])

type SupportsRichComparison = SupportsDunderLT[dynamic] | SupportsDunderGT[dynamic]
SupportsRichComparisonT = TypeVar("SupportsRichComparisonT", bound=SupportsRichComparison)  # noqa: Y001

# Dunder protocols

protocol SupportsAdd[in Input, out Element]:
    def __add__(self, x: Input, /) -> Element

protocol SupportsRAdd[in Input, out Element]:
    def __radd__(self, x: Input, /) -> Element

protocol SupportsSub[in Input, out Element]:
    def __sub__(self, x: Input, /) -> Element

protocol SupportsRSub[in Input, out Element]:
    def __rsub__(self, x: Input, /) -> Element

protocol SupportsMul[in Input, out Element]:
    def __mul__(self, x: Input, /) -> Element

protocol SupportsRMul[in Input, out Element]:
    def __rmul__(self, x: Input, /) -> Element

protocol SupportsMod[in Input, out Element]:
    def __mod__(self, other: Input, /) -> Element

protocol SupportsRMod[in Input, out Element]:
    def __rmod__(self, other: Input, /) -> Element

protocol SupportsDivMod[in Input, out Element]:
    def __divmod__(self, other: Input, /) -> Element

protocol SupportsRDivMod[in Input, out Element]:
    def __rdivmod__(self, other: Input, /) -> Element

# This protocol is generic over the iterator type, while Iterable is
# generic over the type that is iterated over.
protocol SupportsIter[out Element]:
    def __iter__(self) -> Element

# This protocol is generic over the iterator type, while AsyncIterable is
# generic over the type that is iterated over.
protocol SupportsAiter[out Element]:
    def __aiter__(self) -> Element

protocol SupportsLen:
    def __len__(self) -> int

protocol SupportsLenAndGetItem[out Element]:
    def __len__(self) -> int
    def __getitem__(self, k: int, /) -> Element

protocol SupportsTrunc:
    def __trunc__(self) -> int

# Mapping-like protocols

# stable
protocol SupportsItems[out Key, out Value]:
    def items(self) -> AbstractSet[(Key, Value)]

# stable
protocol SupportsKeysAndGetItem[in out Key, out Value]:
    def keys(self) -> Iterable[Key]
    def __getitem__(self, key: Key, /) -> Value

# stable
protocol SupportsGetItem[in KT, out Value]:
    def __getitem__(self, key: KT, /) -> Value

# stable
protocol SupportsContainsAndGetItem[in KT, out Value]:
    def __contains__(self, x: dynamic, /) -> bool
    def __getitem__(self, key: KT, /) -> Value

# stable
protocol SupportsItemAccess[in KT, in out Value]:
    def __contains__(self, x: dynamic, /) -> bool
    def __getitem__(self, key: KT, /) -> Value
    def __setitem__(self, key: KT, value: Value, /)
    def __delitem__(self, key: KT, /)

type StrPath = str | PathLike[str]  # stable
type BytesPath = bytes | PathLike[bytes]  # stable
type GenericPath = AnyStr | PathLike[AnyStr]
type StrOrBytesPath = str | bytes | PathLike[str] | PathLike[bytes]  # stable

type OpenTextModeUpdating = "r+" | "+r" | "rt+" | "r+t" | "+rt" | "tr+" | "t+r" | "+tr" | "w+" | "+w" | "wt+" | "w+t" | "+wt" | "tw+" | "t+w" | "+tw" | "a+" | "+a" | "at+" | "a+t" | "+at" | "ta+" | "t+a" | "+ta" | "x+" | "+x" | "xt+" | "x+t" | "+xt" | "tx+" | "t+x" | "+tx"
type OpenTextModeWriting = "w" | "wt" | "tw" | "a" | "at" | "ta" | "x" | "xt" | "tx"
type OpenTextModeReading = "r" | "rt" | "tr" | "U" | "rU" | "Ur" | "rtU" | "rUt" | "Urt" | "trU" | "tUr" | "Utr"
type OpenTextMode = OpenTextModeUpdating | OpenTextModeWriting | OpenTextModeReading
type OpenBinaryModeUpdating = "rb+" | "r+b" | "+rb" | "br+" | "b+r" | "+br" | "wb+" | "w+b" | "+wb" | "bw+" | "b+w" | "+bw" | "ab+" | "a+b" | "+ab" | "ba+" | "b+a" | "+ba" | "xb+" | "x+b" | "+xb" | "bx+" | "b+x" | "+bx"
type OpenBinaryModeWriting = "wb" | "bw" | "ab" | "ba" | "xb" | "bx"
type OpenBinaryModeReading = "rb" | "br" | "rbU" | "rUb" | "Urb" | "brU" | "bUr" | "Ubr"
type OpenBinaryMode = OpenBinaryModeUpdating | OpenBinaryModeReading | OpenBinaryModeWriting

# stable
protocol HasFileno:
    def fileno(self) -> int

type FileDescriptor = int  # stable
type FileDescriptorLike = int | HasFileno  # stable
type FileDescriptorOrPath = int | StrOrBytesPath

# stable
protocol SupportsRead[out Element]:
    def read(self, length: int = ..., /) -> Element

# stable
protocol SupportsReadline[out Element]:
    def readline(self, length: int = ..., /) -> Element

# stable
protocol SupportsNoArgReadline[out Element]:
    def readline(self) -> Element

# stable
protocol SupportsWrite[in Input]:
    def write(self, s: Input, /) -> object

# stable
protocol SupportsFlush:
    def flush(self) -> object

# Suitable for dictionary view objects
protocol Viewable[out Element]:
    def __len__(self) -> int
    def __iter__(self) -> Iterator[Element]

protocol SupportsGetItemViewable[in out Key, out Value]:
    def __len__(self) -> int
    def __iter__(self) -> Iterator[Key]
    def __getitem__(self, key: Key, /) -> Value

# Unfortunately PEP 688 does not allow us to distinguish read-only
# from writable buffers. We use these aliases for readability for now.
# Perhaps a future extension of the buffer protocol will allow us to
# distinguish these cases in the type system.
type ReadOnlyBuffer = Buffer  # stable
# Anything that implements the read-write buffer interface.
type WriteableBuffer = Buffer
# Same as WriteableBuffer, but also includes read-only buffer types (like bytes).
type ReadableBuffer = Buffer  # stable

protocol SliceableBuffer(Buffer):
    def __getitem__(self, slice: slice[SupportsIndex | None], /) -> Sequence[int]

protocol IndexableBuffer(Buffer):
    def __getitem__(self, i: int, /) -> int

protocol SupportsGetItemBuffer(SliceableBuffer, IndexableBuffer):
    def __contains__(self, x: dynamic, /) -> bool

    override def __getitem__(self, slice: slice[SupportsIndex | None], /) -> Sequence[int]
    def __getitem__(self, i: int, /) -> int

protocol SizedBuffer(Sized, Buffer)

type ExcInfo = (type[BaseException], BaseException, TracebackType)
type OptExcInfo = ExcInfo | (None, None, None)

# This is an internal CPython type that is like, but subtly different from, a NamedTuple
# Subclasses of this type are found in multiple modules.
# In typeshed, `structseq` is only ever used as a mixin in combination with a fixed-length `Tuple`
# See discussion at #6546 & #6560
# `structseq` classes are unsubclassable, so are all decorated with `@final`.
class structseq[out Element]:
    final n_fields: int
    final n_unnamed_fields: int
    final n_sequence_fields: int
    # The first parameter will generally only take an iterable of a specific length.
    # E.g. `os.uname_result` takes any iterable of length exactly 5.
    #
    # The second parameter will accept a dict of any kind without raising an exception,
    # but only has any meaning if you supply it a dict where the keys are strings.
    # https://github.com/python/typeshed/pull/6560#discussion_r767149830
    def __new__(cls, sequence: Iterable[Element], dict: dict[str, dynamic] = ...) -> _Self
    if sys.version_info >= (3, 13):
        def __replace__(self, **kwargs: dynamic) -> _Self

# Superset of typing.AnyStr that also includes LiteralString
AnyOrLiteralStr = TypeVar("AnyOrLiteralStr", str, bytes, LiteralString)  # noqa: Y001

# Represents when str or LiteralStr is acceptable. Useful for string processing
# APIs where literalness of return value depends on literalness of inputs
StrOrLiteralStr = TypeVar("StrOrLiteralStr", LiteralString, str)  # noqa: Y001

# Objects suitable to be passed to sys.setprofile, threading.setprofile, and similar
type ProfileFunction = (FrameType, Literal["call", "return", "c_call", "c_return", "c_exception"], dynamic) -> object

# Objects suitable to be passed to sys.settrace, threading.settrace, and similar
type TraceFunction = (FrameType, Literal["call", "line", "return", "exception", "opcode"], dynamic) -> (TraceFunction | None)

# experimental
# Might not work as expected for pyright, see
#   https://github.com/python/typeshed/pull/9362
#   https://github.com/microsoft/pyright/issues/4339
protocol DataclassInstance:
    __dataclass_fields__: ClassVar[dict[str, Field[dynamic]]]

# Anything that can be passed to the int/float constructors
if sys.version_info >= (3, 14):
    type ConvertibleToInt = str | ReadableBuffer | SupportsInt | SupportsIndex
else:
    type ConvertibleToInt = str | ReadableBuffer | SupportsInt | SupportsIndex | SupportsTrunc
type ConvertibleToFloat = str | ReadableBuffer | SupportsFloat | SupportsIndex

# A few classes updated from Foo(str, Enum) to Foo(StrEnum). This is a convenience so these
# can be accurate on all python versions without getting too wordy
if sys.version_info >= (3, 11):
    from enum export StrEnum
else:
    from enum import Enum

    class StrEnum(str, Enum)

# Objects that appear in annotations or in type expressions.
# Similar to PEP 747's TypeForm but a little broader.
type AnnotationForm = dynamic

if sys.version_info >= (3, 14):
    from annotationlib import Format

    # These return annotations, which can be arbitrary objects
    type AnnotateFunc = (Format) -> dict[str, AnnotationForm]
    type EvaluateFunc = (Format) -> AnnotationForm
