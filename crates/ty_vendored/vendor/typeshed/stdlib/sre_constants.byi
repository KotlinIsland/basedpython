"""Internal support module for sre"""

import sys
from re export error
from typing import Final
from typing_extensions import Self, disjoint_base

final MAXGROUPS: int

final MAGIC: int

if sys.version_info >= (3, 12):
    class _NamedIntConstant(int):
        name: str
        def __new__(cls, value: int, name: str) -> Self

else:
    @disjoint_base
    class _NamedIntConstant(int):
        name: str
        def __new__(cls, value: int, name: str) -> Self

final MAXREPEAT: _NamedIntConstant
OPCODES: list[_NamedIntConstant]
ATCODES: list[_NamedIntConstant]
CHCODES: list[_NamedIntConstant]
OP_IGNORE: dict[_NamedIntConstant, _NamedIntConstant]
OP_LOCALE_IGNORE: dict[_NamedIntConstant, _NamedIntConstant]
OP_UNICODE_IGNORE: dict[_NamedIntConstant, _NamedIntConstant]
AT_MULTILINE: dict[_NamedIntConstant, _NamedIntConstant]
AT_LOCALE: dict[_NamedIntConstant, _NamedIntConstant]
AT_UNICODE: dict[_NamedIntConstant, _NamedIntConstant]
CH_LOCALE: dict[_NamedIntConstant, _NamedIntConstant]
CH_UNICODE: dict[_NamedIntConstant, _NamedIntConstant]
if sys.version_info >= (3, 14):
    CH_NEGATE: dict[_NamedIntConstant, _NamedIntConstant]
# flags
if sys.version_info < (3, 13):
    SRE_FLAG_TEMPLATE: Final = 1
SRE_FLAG_IGNORECASE: Final = 2
SRE_FLAG_LOCALE: Final = 4
SRE_FLAG_MULTILINE: Final = 8
SRE_FLAG_DOTALL: Final = 16
SRE_FLAG_UNICODE: Final = 32
SRE_FLAG_VERBOSE: Final = 64
SRE_FLAG_DEBUG: Final = 128
SRE_FLAG_ASCII: Final = 256
# flags for INFO primitive
SRE_INFO_PREFIX: Final = 1
SRE_INFO_LITERAL: Final = 2
SRE_INFO_CHARSET: Final = 4

# Stubgen above; manually defined constants below (dynamic at runtime)

# from OPCODES
final FAILURE: _NamedIntConstant
final SUCCESS: _NamedIntConstant
final ANY: _NamedIntConstant
final ANY_ALL: _NamedIntConstant
final ASSERT: _NamedIntConstant
final ASSERT_NOT: _NamedIntConstant
final AT: _NamedIntConstant
final BRANCH: _NamedIntConstant
if sys.version_info < (3, 11):
    final CALL: _NamedIntConstant
final CATEGORY: _NamedIntConstant
final CHARSET: _NamedIntConstant
final BIGCHARSET: _NamedIntConstant
final GROUPREF: _NamedIntConstant
final GROUPREF_EXISTS: _NamedIntConstant
final GROUPREF_IGNORE: _NamedIntConstant
final IN: _NamedIntConstant
final IN_IGNORE: _NamedIntConstant
final INFO: _NamedIntConstant
final JUMP: _NamedIntConstant
final LITERAL: _NamedIntConstant
final LITERAL_IGNORE: _NamedIntConstant
final MARK: _NamedIntConstant
final MAX_UNTIL: _NamedIntConstant
final MIN_UNTIL: _NamedIntConstant
final NOT_LITERAL: _NamedIntConstant
final NOT_LITERAL_IGNORE: _NamedIntConstant
final NEGATE: _NamedIntConstant
final RANGE: _NamedIntConstant
final REPEAT: _NamedIntConstant
final REPEAT_ONE: _NamedIntConstant
final SUBPATTERN: _NamedIntConstant
final MIN_REPEAT_ONE: _NamedIntConstant
if sys.version_info >= (3, 11):
    final ATOMIC_GROUP: _NamedIntConstant
    final POSSESSIVE_REPEAT: _NamedIntConstant
    final POSSESSIVE_REPEAT_ONE: _NamedIntConstant
final RANGE_UNI_IGNORE: _NamedIntConstant
final GROUPREF_LOC_IGNORE: _NamedIntConstant
final GROUPREF_UNI_IGNORE: _NamedIntConstant
final IN_LOC_IGNORE: _NamedIntConstant
final IN_UNI_IGNORE: _NamedIntConstant
final LITERAL_LOC_IGNORE: _NamedIntConstant
final LITERAL_UNI_IGNORE: _NamedIntConstant
final NOT_LITERAL_LOC_IGNORE: _NamedIntConstant
final NOT_LITERAL_UNI_IGNORE: _NamedIntConstant
