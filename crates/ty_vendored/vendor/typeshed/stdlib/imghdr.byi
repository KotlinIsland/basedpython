"""Recognize image file formats based on their first few bytes."""

from _typeshed import StrPath
from collections.abc import Callable
from typing import Protocol, type_check_only

__all__ = ["what"]

@type_check_only
protocol _ReadableBinary:
    def tell(self) -> int
    def read(self, size: int, /) -> bytes
    def seek(self, offset: int, /) -> dynamic

def what(file: StrPath | _ReadableBinary, h: None = None) -> str | None:
    """Return the type of image contained in a file or byte stream."""
def what(file: dynamic, h: bytes) -> str | None

tests: list[(bytes, BinaryIO | None) -> (str | None)]
