---
source: crates/ruff_python_formatter/tests/fixtures.rs
input_file: crates/ruff_python_formatter/resources/test/fixtures/ruff/modifiers.by
---
## Input
```bython
abstract class B:
    abstract def f(self) -> int


final class C:
    @override
    def m(self) -> int:
        return 1


# `@`-decorator before a `class def` / `static def` modifier (e.g. decorated
# classmethod overloads like `tarfile.open`)
class D:
    @overload
    class def open(cls, x: int) -> int: ...
    @overload
    static def make(x: str) -> str: ...


# a modifier on an `async def` (e.g. `contextlib`'s `abstract async def __aexit__`)
class E:
    abstract async def f(self) -> int
    final async def g(self) -> int


# `let` declarations, including the valueless read-only form `let x: T` and the
# bare uninitialized form `let x`
let count: int
let total
let name: str = "alice"


class F:
    let member: int
    let label: str = "x"


# `final` annotations (Final in every scope), including a modifier chain where the
# sibling modifier is stripped but `final` is kept
final MODULE_CONST: int
final PAIR: tuple[int, str] = (1, "a")


class G:
    final tag: str
    final override label: str = "x"


# no-op annotation modifiers: the declared type must survive the round trip, with
# and without an initializer, alone and in a chain
override x: int = 1
abstract y: str
private z: int = 2
export e: str = "e"
private override chained: bytes = b""


class H:
    abstract member: int
    override label: str = "x"
```

