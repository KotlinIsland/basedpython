## Input
```bython
# `context` declarations, untyped and typed
context s1 = "asdf"
context s2: str = "fdsa"


# `context` composed with the other declaration modifiers, in either order
context let s3: str = "immutable"
context var s4: str = "mutable"
private context let s5 = "hidden"
context private let s6 = "hidden too"


# `context` parameters: positional-or-keyword (trailing) and keyword-only
def f(a: int, context b: str) -> str:
    return b


def g(a: int, *, context b: str, context c: int) -> int:
    return c


class H:
    def m(self, context b: str) -> str:
        return b


# a declaration inside a function body
def local() -> None:
    context inner = "local"
    f(1)
```

## Output
```bython
# `context` declarations, untyped and typed
context s1      = "asdf"
context s2: str = "fdsa"


# `context` composed with the other declaration modifiers, in either order
context let s3: str    = "immutable"
context var s4: str    = "mutable"
private context let s5 = "hidden"
context private let s6 = "hidden too"


# `context` parameters: positional-or-keyword (trailing) and keyword-only
def f(a: int, context b: str) -> str:
    return b


def g(a: int, *, context b: str, context c: int) -> int:
    return c


class H:
    def m(self, context b: str) -> str:
        return b


# a declaration inside a function body
def local() -> None:
    context inner = "local"
    f(1)
```
