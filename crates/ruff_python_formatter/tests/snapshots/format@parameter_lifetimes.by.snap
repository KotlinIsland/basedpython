---
source: crates/ruff_python_formatter/tests/fixtures.rs
input_file: crates/ruff_python_formatter/resources/test/fixtures/ruff/parameter_lifetimes.by
---
## Input
```bython
# basedpython `local` / `once` parameter modifiers carry no AST field, so the
# formatter recovers them from the source span preceding the parameter name


def once_only(once done: () -> None) -> None:
    done()


def local_only(local fn: () -> None) -> None:
    fn()


# both modifiers, in either source order
def both(once local a: () -> None, local once b: () -> None) -> None: ...


# alongside a `context` modifier, which the AST does record
def with_context(local fn: () -> None, context c: int) -> None: ...


# parameters literally named `local` / `once` are not modifiers
def not_modifiers(local, once) -> None: ...


# a soft keyword after the modifiers is the parameter's name
def soft_keyword_names(local type: int, once  match: () -> None, context cast: int) -> None: ...


# keyword-only, variadic and defaulted parameters
def positions(local a: int, *, once cb: () -> None = print) -> None: ...


# in a callable type the modifier borrows the parameter it precedes, which may be
# named by a soft keyword
def borrows(make: (local type[int], once str) -> int) -> int: ...


# lambdas take the same modifiers
handler = lambda local fn: fn


def multiline(
    local first: () -> None,
    once second: () -> None,
) -> None: ...
```

