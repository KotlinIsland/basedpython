# basedpython `extension` blocks — the synthetic `extension_def` marker renders
# as the `extension` keyword and suppresses the `class` keyword, while the body
# formats as ordinary class-body statements

extension list:
    def second(self) -> Element:
        return self[1]


# reused-parameter bound in the bracket header
extension list[Element: int]:
    def total(self) -> int:
        return sum(self)


# computed property
extension str:
    @property
    def shouty(self) -> str:
        return self.upper()


# `static def` / `class def` members
extension str:
    static def joined(parts: list[str]) -> str:
        return "-".join(parts)
    class def empty(cls) -> str:
        return cls()


# a method introducing its own fresh parameters
extension dict:
    def get_or[R](self, key: Key, default: R) -> Value | R:
        return self[key] if key in self else default


# a conformance list rides where a class's bases do
protocol Show:
    def show(self) -> str


protocol Size:
    def size(self) -> int


extension str(Show):
    override def show(self) -> str:
        return self


# a bracket bound and a conformance list together
extension list[Element: int](Show, Size):
    override def show(self) -> str:
        return ", ".join(str(x) for x in self)

    override def size(self) -> int:
        return len(self)
