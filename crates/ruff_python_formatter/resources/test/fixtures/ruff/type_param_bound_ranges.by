class C[T: int..object]: ...


class WithDefault[T: int..object = str]: ...


class WithVariance[out T: int..object]: ...


class Several[T: int..object, U: str..object]: ...


class PlainBoundIsUnchanged[T: object]: ...


class ConstraintsAreUnchanged[T: constraints (int, str)]: ...


class SelfLowerEnd[T: Self..object]: ...


class ComplexEnds[T: (int | str)..object]: ...


def f[T: int..object](x: T) -> T:
    return x


class Broken[
    T: int..object,
    U: str..object,
]: ...
