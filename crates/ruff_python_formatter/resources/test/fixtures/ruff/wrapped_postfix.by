a: int?
b: int??
c: list[int?]

# the marker binds looser than every type operator it can stand after, so a
# reformat that re-groups any of these would silently change the type
d: str? | int
e: literal str?
m: (int, str)?
n: (*: str)?
o: dict[str, int?]
p: ((int) -> str)?
q: (int) -> str?


def f(x: int?) -> None: ...


def h(g) -> int?:
    x = g()!
    y = g()^
    return y


async def af(g):
    g().await
    g().await.bar().await
    (g()).await
