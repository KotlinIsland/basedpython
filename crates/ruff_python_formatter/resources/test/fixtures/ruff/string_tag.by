# basedpython custom string tags parse as a `tag(t"...")` call, but the surface
# form glues the template straight onto the tag name

from string.templatelib import Template


class Query: ...


def sql(template: Template) -> Query: ...


def html(template: Template) -> str: ...


q = sql"select * from t"
page = html"<p>{name}</p>"

# as a call argument
print(html"hi {1}")

# an interpolation carrying an expression
detail = html"<i>{value + 1}</i>"

# a plain call on the same name is still a call
plain = sql(t"select 1")

# an attribute carries a tag too, which is the spelling that survives a local of
# the same name shadowing the tag


class Doc:
    def text(self, template: Template) -> str: ...


doc = Doc()
line = doc.text"hello {name}"
interpolated = doc.text"{name} and {other}"
