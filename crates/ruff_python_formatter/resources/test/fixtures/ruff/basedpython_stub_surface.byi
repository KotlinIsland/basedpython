# a stub is written in basedpython too, so the whole surface has to survive a
# reformat. dropping any of it here would be a silent semantic change: a
# covariant parameter would come back invariant, and `protocol` would come back
# as a plain class
protocol Iterable[out Element]:
    abstract def __iter__(self) -> Iterator[Element]

protocol Sized(metaclass=ABCMeta):
    abstract def __len__(self) -> int

class Pair[in out Key, in Sink, out Value]:
    let key: Key
    let value: Value
    def send(self, sink: Sink) -> None

class Bounded[Element: int, Text in (str, bytes), Defaulted = int]:
    let element: Element

protocol Callable[in Parameters: (*: *, **: *), out Return]:
    abstract def __call__(self, *args: *Parameters, **kwargs: **Parameters) -> Return

final class Frozen:
    final size: int

# a soft keyword is an ordinary name outside the construct it introduces, and
# typeshed declares fields called `type` (`socket`, `asyncio.trsock`)
class Socket:
    let type: int
    let match: str
    var case: bytes

# the vendored typeshed spells an optional with the postfix marker, in every
# position a stub writes one
class Cursor:
    let description: str?
    def fetchone(self) -> (int, str)?
    def execute(self, sql: str, parameters: Sequence[dynamic]? = None) -> Self
    def setinputsizes(self, sizes: literal str? = None) -> None
