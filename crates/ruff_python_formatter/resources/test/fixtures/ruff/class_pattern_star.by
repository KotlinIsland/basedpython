match shape:
    case Line(start, *_, end):
        print(start, end)
    case Line(start, *_):
        print(start)
    case Line(*_, end):
        print(end)
    case Line(*_):
        pass
    case Line(start, *_, colour=c):
        print(start, c)

match shape:
    case Outer(Line(start, *_, end)):
        print(start, end)
    case Line(start, *_, end) if start < end:
        print(start)
    case Line(start, *_, end) as whole:
        print(whole)

match shape:
    case VeryLongClassNameForThisPattern(first_capture_name, *_, last_capture_name_here):
        pass

match shape:
    case Line(
        start,  # the first
        *_,  # everything between
        end,
    ):
        pass

let Line(start, *_, end) := shape

if let Line(start, *_, end) := shape:
    print(start, end)

for Line(start, *_, end) in shapes:
    print(start, end)
