class C[A, /, B, *, D]: ...


class OnlySlash[A, B, /, C]: ...


class OnlyStar[A, *, B, C]: ...


class TrailingSlash[A, /]: ...


class LeadingStar[*, A, B]: ...


class AdjacentSeparators[A, /, *, B]: ...


class WithVariance[out A, /, in B, *, D]: ...


def f[A, /, B, *, D](a: A, b: B, d: D) -> A:
    return a


class Broken[
    A,
    /,
    B,
    *,
    D,
]: ...
