# basedpython spells identity `===` / `!==`; a plain `is` is a type test, which the
# parser flattens to the same operator. only the identity spellings compare identity
def identity(x: object) -> None:
    print(1 === 1)  # F632
    print(x !== "a")  # F632


# a literal target names a literal type: `x is 1` tests for `Literal[1]`, which
# needs the class and the value both, so there is no `==` to suggest
def literal_types(x: object) -> None:
    print(1 is 1)
    print(x is not "a")
    print(x is 5000)
    print(x is b"a")


def type_tests[T](x: T, xs: list[int]) -> None:
    print(1 is T)
    print(xs is list[int])
    # this one is not a type at all — but the mistake in it is the target, not the
    # operator, so it is ty's to report
    print([] is [])


# a type test may end a chain, sharing its value with the comparison before it, so
# that comparison is not rewritten as if it stood alone
def chain_ending_in_a_type_test(x: object) -> None:
    print(1 === 1 is int)
    print((1) === (x) is int)


# which spelling was written is recorded on the comparison, not recovered from the
# source between the operands, so it survives everything that can sit there
def spelling_survives_what_sits_between(x: object) -> None:
    a = (1) === (1)  # F632
    b = 1 \
        === 1  # F632
    c = (1 ===  # a comment between the operands
         1)  # F632
    d = 1===1  # F632


# each operator of a chain answers for its own spelling
def chained(x: object) -> None:
    e = x < 1 === 1  # F632
    f = 1 === 1 !== 2  # F632
