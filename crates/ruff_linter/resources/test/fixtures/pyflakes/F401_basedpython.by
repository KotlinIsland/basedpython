# F401 does not check a `.by` file. whether an import there is used can depend on the
# `extension`s and conformances its module declares, which only types tell, so
# `by check` reports an unused import instead, as `unused-import`
import json
from c import unused_name
from e import extended_type

extension extended_type:
    def extra(self) -> int:
        return 0
