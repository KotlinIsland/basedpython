def f(x: int = 1, a: (int) -> str):
    a(x)


# consecutive trailing lambda blocks share the synthetic
# `__trailing_lambda__` name; they are call statements, not redefinitions
f:
    print(it)

f(2):
    print(it)

f:
    print(it)


# an `extension T:` header names the type it extends — a reference to that
# declaration, not a second one
class Target:
    pass


protocol Iface:
    def m(self) -> int


extension Target:
    def extra(self) -> int:
        return 0


extension Target(Iface):
    override def m(self) -> int:
        return 1


# a real redefinition still fires
def g():
    pass


def g():
    pass
