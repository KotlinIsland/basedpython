def f(x: int = 1, a: (int) -> str):
    a(x)


# consecutive trailing lambda blocks share the synthetic
# `__trailing_lambda__` name; they are call statements, not redefinitions
f:
    print(it)

f(2):
    print(it)

f:
    print(it)


# an `extension T:` / `implementation I for T:` header names the type it extends
# or implements — a reference to that declaration, not a second one
class Target:
    pass


class Iface:
    pass


extension Target:
    def extra(self) -> int:
        return 0


implementation Iface for Target as TargetAsIface:
    def m(self) -> int:
        return 1


# a real redefinition still fires
def g():
    pass


def g():
    pass
