class A(list[A]):
    pass

class B(dict[str, list[B | None]]):
    pass

class C(C):
    pass

class D(list[Z]):
    pass

# `dynamic` is the surface spelling of `typing.Any` in type position — not undefined
x: dynamic
def f(a: dynamic) -> dynamic: ...
xs: list[dynamic]

# in value position `dynamic` is an ordinary name — still flagged when unbound
print(dynamic)

# `cast` / `cast?` are keyword operators, not name references — the synthetic
# `cast` callee must not be flagged as undefined
val = 1
ok_cast = val cast int
ok_try = val cast? int
# but an undefined *type* argument to the cast is still a real reference
bad_cast = val cast UndefinedType

# `-> asserts x` names the place a call narrows, not a type: the name is the
# callee's own parameter, so it must not be resolved in the enclosing scope
def check(x: int | None) -> asserts x:
    if x is None:
        raise ValueError

def check_empty(x: str | None) -> asserts not x:
    if x:
        raise ValueError

# a `name is T` predicate names its target the same way, so it isn't resolved
# in the enclosing scope either
def guard() -> undefined_place is int:
    return True

# the type in `asserts x is T` is a real type reference — flagged when undefined
def check_type(x: object) -> asserts x is UndefinedGuardType:
    raise ValueError

# a guard on a member names a place, not a reference — `self` is not resolved here
class Guarded:
    data: str | None = None

    def ensure(self) -> asserts self.data is not None:
        raise ValueError

    def loaded(self) -> self.data is str:
        return True

# inline protocol member names and a method's receiver are labels, not
# references — only the member *types* are real name references
Defined = int
good_protocol: protocol(a: Defined; def m(self, n: Defined) -> Defined)
bad_protocol: protocol(a: UndefinedMember; def m(self) -> UndefinedReturn)

# a match type's `case` captures are type variables, and its bodies are type
# expressions — neither is visited, so nothing inside is resolved either way. the
# bound on a `TypeVarTuple` *is* a real type reference
type NDTuple[T, *Shape: int] = match *Shape:
    case ():
        T
    case (Dim, *Rest):
        (NDTuple[T, *Rest],) * Dim

type BadBound[*Ts: UndefinedBound] = tuple[*Ts]

# a pack's bound is a type expression wherever it appears, so names inside the
# starred whole-pack forms and a keyword-variadic pack's bound resolve too
type WholeTuple[*Ts: *(int, UndefinedElement)] = tuple[*Ts]
type EveryField[**Kwargs: UndefinedFieldBound] = int
type WholeShape[**Kwargs: **{"a": UndefinedField}] = int
type BoundsAreFine[*Ts: *(int, str), **Kwargs: **{"a": int}] = int

# the `typing` members basedpython auto-imports are implicitly available in any
# position — the transpiler emits the matching `from typing import ...`
implicit_annotation: Optional[Sequence[int]]
def implicit_params(a: Mapping[str, Any], b: Iterator[int]) -> Tuple[List[int], ...]: ...
implicit_value = Optional
# a `typing` member basedpython does *not* auto-import is still flagged
not_implicit: Protocol

# `Some` is the present-case optional constructor, lowered to the injected
# `Optional(...)` wrapper — it has no runtime definition to import
some_value = Some(1)

# `Character` and `Overlapping` are `ty_extensions` special forms implicitly
# available in a type position
a_character: Character
overlapping_arg: Overlapping[int]
# in value position they are ordinary names — still flagged when unbound
print(Character, Overlapping)

# known gap: an enum member reached by context-sensitive resolution is an
# arbitrary identifier whose resolution needs the expected type, which ruff has
# no access to. `by check` accepts it; F821 reports it, and `# noqa: F821` is
# the escape hatch
enum class Color:
    case Red, Green

context_sensitive: Color = Red


# context-sensitive resolution writes an enum variant bare where the expected
# type is its enum; the transpiler rewrites it to `Colour.Red`. whether *this*
# site really has that expected type takes the type, so the linter defers — but
# a name matching no variant at all is still reported
enum class Colour:
    case Red
    case Green


def paint(c: Colour = Red) -> Colour:
    return c


chosen: Colour = Green
missing: Colour = Bleu  # F821


# a trailing-lambda block filling a receiver callback binds the receiver as
# `self`, in a parameter the source cannot spell. every member of that receiver
# is in scope unqualified too, at any depth — which member names those are takes
# the receiver's type, so nothing unresolved inside a block is reported here.
# `by check` reports the ones that really are unresolved
def apply(fn: int.(str) -> None) -> None:
    fn(1, "a")


def run() -> None:
    apply:
        print(self)
        print(it)
        a_receiver_member("x")
        nested_block:
            another_receiver_member("y")


# but the deferral stops at the block: the same name outside one is reported
a_receiver_member("x")  # F821


# a destructuring binder binds its pattern's captures where the binder itself is
# bound — the parameter's in the function it heads, the loop's and the `with`
# item's in the scope around them. the binder holding the value they came from is
# machinery the source cannot spell, so nothing here is undefined
class Point:
    __match_args__ = ("x", "y")


def destructured_parameter(Point(px, py): Point) -> int:
    return px + py


def destructured_binders(points: list[Point], ctx: object) -> None:
    let Point(a, b) := points[0]
    print(a, b)

    for Point(c, d) in points:
        print(c, d)

    with ctx as Point(e, f):
        print(e, f)

    if let Point(g, h) := points[0]:
        print(g, h)


# an unbound name inside a pattern is still reported
def undefined_in_pattern(value: object) -> None:
    if let UndefinedPattern(captured) := value:  # F821
        print(captured)


# a conformance extension introduces no binding: both its own name and the
# interfaces it names are references to existing declarations
class Implemented:
    pass


protocol Interface:
    def m(self) -> int


extension Implemented(Interface):
    override def m(self) -> int:
        return 1


print(Implemented())

# the conformance list is an ordinary reference and is reported when undefined;
# the extended type is looked up rather than resolved, so an undefined one is a
# known gap here — `by check` reports it as an unresolved type
extension UndefinedImplemented(UndefinedInterface):  # F821
    pass


# a django lookup expression: the transpiler lowers the field path to the
# keyword it spells (`filter(author.name == "x")` -> `filter(author__name="x")`),
# so the path is never evaluated and none of these names is undefined
class Model:
    objects: object


Book = Model()
Book.objects.filter(author.name == "Ursula")
Book.objects.filter(published > 1)
Book.objects.filter(data["key"] == 1)
Book.objects.exclude(title == "x", author.pk >= 3)
Book.objects.filter(pk in [1, 2, 3])
Book.objects.get(pk == 1)

# but the suppression is only for that shape, so each of these is still reported
Book.objects.filter(bare_name)  # F821
Book.objects.annotate(not_a_lookup_method.x == 1)  # F821
Book.objects.filter(data[undefined_index] == 1)  # F821
Book.objects.filter(no_lookup_for_ne != 1)  # F821


# a `raises` clause is an ordinary type expression, so an undefined name written
# there is a real reference and is reported
def raises_undefined() raises UndefinedRaised:  # F821
    raise ValueError
