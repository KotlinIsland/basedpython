# basedpython re-evaluates a non-scalar default on every call, so a call in a
# default position is already per-call and needs no rewriting
class Units:
    init(let items: list[int])


def collect(seen: Units = Units([])) -> Units:
    return seen


def timed(started: object = object()) -> object:
    return started


# a lambda is the exception: the rewrite is driven off `def`, so a lambda's
# default is evaluated once and the hazard is real
import datetime

made_once = lambda a=datetime.datetime.now(), b=Units([]): (a, b)
