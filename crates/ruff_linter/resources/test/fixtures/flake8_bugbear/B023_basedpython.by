def run(fn: () -> None):
    fn()


# OK: a trailing-lambda block (`run:` + suite) lowers to a closure, but whether
# it can outlive the loop depends on the callee's `local` / `once` marker — type
# information this syntactic rule cannot resolve. It is left to the type-aware ty
# lint, so B023 does not fire here even though `x` is a loop variable.
for x in [1, 2, 3]:
    run:
        print(x)


# OK: basedpython gives each iteration its own binding for the loop target, so
# the wrapper this lambda is applied through reads this iteration's value.
fns = []
for x in [1, 2, 3]:
    fns.append(lambda: x)


# OK: a comprehension target is bound per element the same way.
comprehended = [lambda: x for x in [1, 2, 3]]


# Not OK: a `def` reads a *module-level* loop target as a global, which the
# closure rebind has no cell for — so this one keeps python's late binding.
defs = []
for x in [1, 2, 3]:

    def handler():
        print(x)

    defs.append(handler)


def collect() -> list:
    # OK: inside a function the target is a closure cell, which the rebind does
    # reach, so the same `def` reads this iteration's value.
    handlers = []
    for x in [1, 2, 3]:

        def handler():
            print(x)

        handlers.append(handler)
    return handlers


# Not OK: a non-scalar default is re-evaluated per call from inside the body, so
# it reads the module-level target as a global just as a body read does.
defaulted = []
for x in [1, 2, 3]:

    def defaulted_handler(value=x):
        return value

    defaulted.append(defaulted_handler)


# OK: a scalar default stays a plain python default, bound eagerly at `def`
# time, so it still captures this iteration's value.
scalars = []
for x in [1, 2, 3]:

    def scalar_handler(value=1):
        return value

    scalars.append(scalar_handler)


def collect_defaults() -> list:
    # OK: inside a function the relocated default reads a closure cell, which
    # the rebind reaches, so it names this iteration's value.
    handlers = []
    for x in [1, 2, 3]:

        def handler(value=x):
            return value

        handlers.append(handler)
    return handlers


def accumulate() -> list:
    # Not OK: a name merely *assigned* in the body is not a loop binding —
    # basedpython resolves those late, exactly as python does.
    fns = []
    for x in [1, 2, 3]:
        doubled = x * 2
        fns.append(lambda: doubled)
    return fns


def properties() -> list:
    # A property accessor is a `def` the parser synthesized, and the transpiler
    # does not rebind it — so the late binding is real and must still be flagged.
    holders = []
    for x in [1, 2, 3]:

        class Holder:
            var scale: int = 0
                get() = field * x

        holders.append(Holder())
    return holders
