# a type test against a literal type compares the value with the literal at
# runtime, so the secret is written there all the same
def check(password: str, token: object) -> None:
    print(password is "s3cr3t")  # S105
    print(token is not "s3cr3t")  # S105
    print(password === "s3cr3t")  # S105
    print(password is str)
    print(password is "")
    # a chain ending in a type test compares the value with each literal in it
    print(password == "s3cr3t" is str)  # S105
