BY021 [*] `@property` can be written as `var age` with accessors
  --> BY021.by:16:5
   |
15 |       # a getter and its setter, both annotated
16 | /     @property
17 | |     def age(self) -> int:
18 | |         return self._age
19 | |
20 | |     @age.setter
21 | |     def age(self, value: int) -> None:
22 | |         assert value >= 0
23 | |         self._age = value
   | |_________________________^
help: Replace with a `var age` declaration
   |
15 |     # a getter and its setter, both annotated
   -     @property
   -     def age(self) -> int:
   -         return self._age
   -
   -     @age.setter
   -     def age(self, value: int) -> None:
   -         assert value >= 0
   -         self._age = value
16 +     var age: int
17 +         get() = self._age
18 +         set(value):
19 +             assert value >= 0
20 +             self._age = value
21 |
   |

