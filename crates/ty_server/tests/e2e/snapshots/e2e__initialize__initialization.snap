{
  "capabilities": {
    "positionEncoding": "utf-16",
    "textDocumentSync": {
      "openClose": true,
      "change": 2,
      "save": {
        "includeText": false
      }
    },
    "notebookDocumentSync": {
      "notebookSelector": [
        {
          "cells": [
            {
              "language": "python"
            }
          ]
        }
      ],
      "save": false
    },
    "completionProvider": {
      "triggerCharacters": [
        ".",
        "\"",
        "'",
        "{",
        "%",
        "|"
      ]
    },
    "hoverProvider": true,
    "signatureHelpProvider": {
      "triggerCharacters": [
        "(",
        ",",
        ":"
      ],
      "retriggerCharacters": [
        ")"
      ]
    },
    "declarationProvider": true,
    "definitionProvider": true,
    "typeDefinitionProvider": true,
    "implementationProvider": true,
    "referencesProvider": true,
    "documentHighlightProvider": true,
    "documentSymbolProvider": true,
    "codeActionProvider": {
      "codeActionKinds": [
        "quickfix",
        "refactor.inline.variable",
        "refactor.extract.variable",
        "refactor.extract.constant",
        "refactor.extract.parameter",
        "refactor.extract.field",
        "refactor.extract.function",
        "refactor.rewrite.returnAnnotation",
        "refactor.rewrite.toDataClass",
        "refactor.rewrite.fromDataClass",
        "refactor.rewrite.splitList",
        "refactor.rewrite.joinList",
        "refactor.rewrite.invertIf",
        "refactor.rewrite.deMorgan",
        "refactor.rewrite.flipQuotes",
        "refactor.rewrite.loopToComprehension"
      ],
      "resolveProvider": true
    },
    "codeLensProvider": {
      "resolveProvider": false
    },
    "workspaceSymbolProvider": true,
    "documentOnTypeFormattingProvider": {
      "firstTriggerCharacter": ":"
    },
    "renameProvider": {
      "prepareProvider": true
    },
    "foldingRangeProvider": true,
    "selectionRangeProvider": true,
    "executeCommandProvider": {
      "commands": [
        "ty.printDebugInformation",
        "ty.runManageCommand",
        "ty.addDependency"
      ],
      "workDoneProgress": false
    },
    "callHierarchyProvider": true,
    "semanticTokensProvider": {
      "legend": {
        "tokenTypes": [
          "namespace",
          "class",
          "parameter",
          "selfParameter",
          "clsParameter",
          "variable",
          "property",
          "function",
